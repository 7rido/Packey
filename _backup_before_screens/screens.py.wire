"""screens.py — six Telegram screens, each its own function.

Owns: how these six screens LOOK and what their buttons do. Nothing here
decides carrier routing, cadence or payments, and nothing sends a screen on its
own: they are shown by an explicit user action (or, for the owner, /screens N
to preview them). Wiring a screen to a live event (e.g. sending the delivery
alert when a package flips to Out for Delivery) is a separate, deliberate step.

Review order (one function family per screen):
  1. tracking_card_*      / screen_tracking_card   Rich Message, HTML fallback
  2. package_list_*       / screen_package_list
  3. delivery_alert_*     / screen_delivery_alert  + screen_delivered_followup
  4. add_number_*         / screen_add_by_number
  5. settings_*           / screen_settings        (+ notify_allowed, used by refresh)
  6. miniapp_button_*     / screen_miniapp_button

Facts the screens rely on (checked against the 17TRACK v2.4 docs): 17TRACK has
NO live driver position and NO stops-away count, so neither is ever shown. It
does return a scan list, an estimated delivery window and sometimes scan
coordinates; the screens show those only when they were actually stored.
"""
from __future__ import annotations

import asyncio
import json
import logging
import os
import time
from datetime import datetime, timedelta, timezone
from html import escape
from pathlib import Path
from typing import Dict, List, Optional, Tuple

from aiogram import F, Router
from aiogram.enums import ChatType, ParseMode
from aiogram.filters import Command
from aiogram.types import (
    CallbackQuery, ForceReply, InlineKeyboardButton, InlineKeyboardMarkup,
    Location, MenuButtonWebApp, Message, WebAppInfo,
)

try:    # Rich Messages need aiogram 3.31+ (Bot API 10.3, Python 3.10+)
    from aiogram.types import (
        InputRichBlockDetails, InputRichBlockDivider, InputRichBlockFooter,
        InputRichBlockList, InputRichBlockListItem, InputRichBlockMap,
        InputRichBlockParagraph, InputRichMessage, RichTextBold, RichTextCode,
        RichTextItalic, RichTextMarked,
    )
    RICH_AVAILABLE = True
except ImportError:     # older aiogram: the card is always sent as HTML text
    RICH_AVAILABLE = False

import carriers
import config
import storage
import ui

logger = logging.getLogger(__name__)
router = Router()

# Rich Messages (Bot API 10.1+) for screen 1. Any failure to send or edit one
# falls back to HTML text, so this switch only decides which is tried first.
RICH_SCREENS = RICH_AVAILABLE and os.getenv("SCREENS_RICH", "1").strip().lower() not in (
    "0", "false", "no")

# Screen 2 rules, from the owner's call on 2026-10-19.
DELAYED_AFTER_DAYS = 3        # In Transit with no new scan for this long = delayed
ARCHIVE_AFTER_DAYS = 14       # Delivered longer ago than this = Archive
# NOTE: delivered packages are forgotten after config.RETENTION_DAYS (default 14),
# so with the default the Archive filter is normally empty. Lower RETENTION_DAYS'
# purge or raise it to give Archive anything to show.

QUIET_START_HOUR, QUIET_END_HOUR = 22, 7   # server-local time, see screen 5


# ── shared helpers ──────────────────────────────────────────────────────────
def _parse_iso(value) -> Optional[datetime]:
    if not value or not isinstance(value, str):
        return None
    try:
        dt = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)


def _age_days(value, now: Optional[datetime] = None) -> Optional[float]:
    dt = _parse_iso(value)
    if dt is None:
        return None
    return ((now or datetime.now(timezone.utc)) - dt).total_seconds() / 86400.0


def _save() -> None:
    import refresh                      # lazy: refresh imports this module back
    refresh.save_now()


def _packages(chat_id: int) -> Dict[str, dict]:
    return storage.track_sessions.get(chat_id, {})


# Pill = the status in one short word group, with the same colored circles the
# rest of the bot uses (ui.status_badge).
_PILL_TEXT = {
    "Delivered": "Delivered",
    "Out for Delivery": "Out for delivery",
    "In Transit": "In transit",
    "Info Received": "Label created",
    "Available for Pickup": "Ready for pickup",
    "Delivery Attempted": "Problem",
    "Exception": "Problem",
}


def pill_kind(info: dict, now: Optional[datetime] = None) -> str:
    """in_transit | out_for_delivery | delayed | problem | delivered | other"""
    status = info.get("status") or "Pending"
    if status == "Delivered":
        return "delivered"
    if status == "Out for Delivery":
        return "out_for_delivery"
    if status in ("Exception", "Delivery Attempted") or info.get("lost") is True:
        return "problem"
    if status == "In Transit":
        quiet = _age_days(info.get("last_event_at") or info.get("last_updated"), now)
        if quiet is not None and quiet >= DELAYED_AFTER_DAYS:
            return "delayed"
        return "in_transit"
    return "other"


_PILL_BY_KIND = {
    "in_transit": ("\U0001f535", "In transit"),
    "out_for_delivery": ("\U0001f7e0", "Out for delivery"),
    "delayed": ("\U0001f7e1", "Delayed"),
    "problem": ("\U0001f534", "Problem"),
    "delivered": ("\U0001f7e2", "Delivered"),
}


def status_pill(info: dict, now: Optional[datetime] = None) -> str:
    kind = pill_kind(info, now)
    if kind in _PILL_BY_KIND:
        icon, label = _PILL_BY_KIND[kind]
        return f"{icon} {label}"
    status = info.get("status") or "Pending"
    return f"{ui.status_badge(status)} {_PILL_TEXT.get(status, status)}"


# 4 segments: label created -> in transit -> out for delivery -> delivered.
_STAGE_BY_STATUS = {
    "Pending": 1, "Info Received": 1,
    "In Transit": 2, "Exception": 2,
    "Out for Delivery": 3, "Delivery Attempted": 3, "Available for Pickup": 3,
    "Delivered": 4,
}


def progress_bar(status: str) -> str:
    done = _STAGE_BY_STATUS.get(status or "Pending", 1)
    return "▰" * done + "▱" * (4 - done)


def recent_events(info: dict, limit: Optional[int] = None) -> List[dict]:
    """Stored scans, newest first. A package from a source that only reports its
    latest scan (browser tier, USPS) has just that one, from `detail`."""
    events = [e for e in (info.get("events") or []) if isinstance(e, dict) and e.get("d")]
    if not events and info.get("detail"):
        events = [{"t": info.get("last_event_at") or info.get("last_updated") or "",
                   "d": info["detail"], "l": ""}]
    return events if limit is None else events[:limit]


def _event_when(event: dict) -> str:
    """'today 6:12 AM' / 'yesterday 4:30 PM' / 'Oct 15, 9:05 AM'."""
    dt = _parse_iso(event.get("t"))
    if dt is None:
        return ""
    today = datetime.now(timezone.utc).date()
    clock = f"{dt:%-I:%M %p}"
    if dt.date() == today:
        return f"today {clock}"
    if dt.date() == today - timedelta(days=1):
        return f"yesterday {clock}"
    return f"{dt:%b %-d}, {clock}"


def last_scan_coordinates(info: dict) -> Optional[Tuple[float, float]]:
    """Coordinates of the newest scan that carries them — and only that: this is
    where the parcel WAS, not where it is now (no carrier feed gives live position)."""
    for event in recent_events(info):
        if "lat" in event and "lon" in event:
            return event["lat"], event["lon"]
    return None


def delivery_window(info: dict) -> Optional[str]:
    """'Tue Oct 20, 2–4 PM' style text from 17TRACK's estimated window, or None."""
    eta = info.get("eta") or {}
    start, end = _parse_iso(eta.get("from")), _parse_iso(eta.get("to"))
    if start is None and end is None:
        return None
    start = start or end
    if end is None or end == start:
        return start.strftime("%a %b %-d")
    if start.date() == end.date() and (start.hour or end.hour):
        return f"{start:%a %b %-d}, {start:%-I %p}–{end:%-I %p}"
    return f"{start:%a %b %-d} – {end:%a %b %-d}"


def delivery_time_range(info: dict) -> Optional[str]:
    """'2:00 to 4:00 PM' when the estimated window sits inside one day, else None."""
    eta = info.get("eta") or {}
    start, end = _parse_iso(eta.get("from")), _parse_iso(eta.get("to"))
    if start is None or end is None or start.date() != end.date() or not (start.hour or end.hour):
        return None
    first = f"{start:%-I:%M}" if f"{start:%p}" == f"{end:%p}" else f"{start:%-I:%M %p}"
    return f"{first} to {end:%-I:%M %p}"


def eta_day(info: dict, now: Optional[datetime] = None) -> Optional[str]:
    """'today' or a short weekday ('Thu') for the estimated delivery, or None."""
    eta = info.get("eta") or {}
    dt = _parse_iso(eta.get("from")) or _parse_iso(eta.get("to"))
    if dt is None:
        return None
    today = (now or datetime.now(timezone.utc)).date()
    return "today" if dt.date() == today else f"{dt:%a}"


def package_subline(info: dict, now: Optional[datetime] = None) -> str:
    """'UPS · Thu' under a package name in the list. Never a tracking number."""
    carrier = info.get("carrier_name") or "Unknown carrier"
    kind = pill_kind(info, now)
    if kind == "delayed":
        tail = "delayed"
    elif kind == "problem":
        tail = "exception"
    elif kind == "delivered":
        tail = "delivered"
    else:
        tail = eta_day(info, now) or (info.get("status") or "pending").lower()
    return f"{carrier} · {tail}"


# The step after the current one, shown as the open circle at the end of the timeline.
_NEXT_STEP = {
    "Pending": "In transit", "Info Received": "In transit",
    "In Transit": "Out for delivery", "Exception": "Out for delivery",
    "Out for Delivery": "Delivered",
}


async def _send(target: Message, text: str, kb: Optional[InlineKeyboardMarkup],
                *, ttl: Optional[int] = None) -> Message:
    """HTML screen, deleted after the usual ephemeral TTL (it names packages)."""
    return await ui.send_ephemeral(target, text, ttl=ttl, parse_mode=ParseMode.HTML,
                                   reply_markup=kb, disable_web_page_preview=True)


# ═══════════════════════════════════════════════════════════════════════════
# 1. TRACKING CARD
# ═══════════════════════════════════════════════════════════════════════════
def _place_when(ev: dict) -> str:
    return " · ".join(p for p in (ev.get("l"), _event_when(ev)) if p)


def _event_lines_html(events: List[dict]) -> List[str]:
    lines = []
    for ev in events:
        line = f"● <b>{escape(ev['d'])}</b>"
        place = _place_when(ev)
        if place:
            line += f"\n    <i>{escape(place)}</i>"
        lines.append(line)
    return lines


def tracking_card_html(tid: str, info: dict) -> str:
    """HTML fallback: same content as the rich card."""
    name = escape(info.get("name") or "Package")
    status = info.get("status")
    lines = [f"\U0001f4e6 <b>{name}</b>   {escape(status_pill(info))}",
             f"{escape(info.get('carrier_name') or 'Unknown carrier')} · <code>{escape(tid)}</code>",
             f"<code>{progress_bar(status)}</code>"]
    window = delivery_window(info)
    if window and status != "Delivered":
        lines.append(f"Arriving <b>{escape(window)}</b>")
    lines.append("")
    events = recent_events(info)
    if events:
        lines.extend(_event_lines_html(events[:3]))
        step = _NEXT_STEP.get(status or "Pending")
        if step:
            lines.append(f"○ <i>{escape(step)}</i>")
        if len(events) > 3:
            body = "\n".join(_event_lines_html(events))
            lines += ["", f"<b>Full history ({len(events)} events)</b>\n"
                          f"<blockquote expandable>{body}</blockquote>"]
    else:
        lines.append("<i>No scans yet.</i>")
    lines += ["", f"<i>Updated {escape(storage.format_ts(info.get('last_updated')))}</i>"]
    return "\n".join(lines)


def _rich_events(events: List[dict]) -> InputRichBlockList:
    items = []
    for ev in events:
        blocks: list = [InputRichBlockParagraph(text=[RichTextBold(text=ev["d"])])]
        place = _place_when(ev)
        if place:
            blocks.append(InputRichBlockParagraph(text=RichTextItalic(text=place)))
        items.append(InputRichBlockListItem(blocks=blocks))
    return InputRichBlockList(items=items)


def tracking_card_rich(tid: str, info: dict) -> InputRichMessage:
    pill = status_pill(info)
    status = info.get("status")
    blocks: list = [
        InputRichBlockParagraph(text=[
            RichTextBold(text=info.get("name") or "Package"), "   ",
            RichTextMarked(text=f" {pill} ")]),
        InputRichBlockParagraph(text=[
            f"{info.get('carrier_name') or 'Unknown carrier'} · ",
            RichTextCode(text=tid)]),
        InputRichBlockParagraph(text=[RichTextCode(text=progress_bar(status))]),
    ]
    window = delivery_window(info)
    if window and status != "Delivered":
        blocks.append(InputRichBlockParagraph(
            text=["Arriving ", RichTextBold(text=window)]))
    events = recent_events(info)
    if events:
        blocks.append(_rich_events(events[:3]))
        step = _NEXT_STEP.get(status or "Pending")
        if step:
            blocks.append(InputRichBlockParagraph(
                text=RichTextItalic(text=f"○ {step}")))
        if len(events) > 3:
            blocks.append(InputRichBlockDetails(
                summary=f"Full history ({len(events)} events)",
                blocks=[_rich_events(events)]))
    else:
        blocks.append(InputRichBlockParagraph(text=RichTextItalic(text="No scans yet.")))
    coords = last_scan_coordinates(info)
    if coords:
        blocks.append(InputRichBlockMap(
            location=Location(latitude=coords[0], longitude=coords[1]),
            zoom=12, width=600, height=300))
    blocks.append(InputRichBlockDivider())
    blocks.append(InputRichBlockFooter(
        text=f"Updated {storage.format_ts(info.get('last_updated'))}"))
    return InputRichMessage(blocks=blocks)


def tracking_card_keyboard(tid: str, info: dict) -> InlineKeyboardMarkup:
    muted = bool(info.get("muted"))
    rows = [[
        InlineKeyboardButton(text="\U0001f504 Refresh", callback_data=f"sc1:r:{tid}",
                             style="primary"),
        InlineKeyboardButton(text="\U0001f50a Unmute" if muted else "\U0001f515 Mute",
                             callback_data=f"sc1:m:{tid}"),
    ]]
    coords = last_scan_coordinates(info)
    if coords:
        # Shown only when a scan carried coordinates; it opens the LAST SCAN
        # location (no carrier feed gives a live position).
        url = (f"https://www.openstreetmap.org/?mlat={coords[0]:.5f}"
               f"&mlon={coords[1]:.5f}#map=13/{coords[0]:.5f}/{coords[1]:.5f}")
        rows.append([InlineKeyboardButton(text="\U0001f5fa Open live map", url=url)])
    return InlineKeyboardMarkup(inline_keyboard=rows)


async def _deliver_card(bot, chat_id: int, tid: str, info: dict,
                        *, edit_message: Optional[Message] = None) -> Optional[Message]:
    """Rich first, HTML on any failure. Edits when asked, else sends fresh."""
    kb = tracking_card_keyboard(tid, info)
    if RICH_SCREENS:
        try:
            rich = tracking_card_rich(tid, info)
            if edit_message is not None:
                await bot.edit_message_text(
                    chat_id=chat_id, message_id=edit_message.message_id,
                    rich_message=rich, reply_markup=kb)
                return edit_message
            return await bot.send_rich_message(chat_id=chat_id, rich_message=rich,
                                               reply_markup=kb)
        except Exception as exc:       # old client/API, bad block, rate limit...
            logger.info("rich card failed (%s) — falling back to HTML", type(exc).__name__)
    html = tracking_card_html(tid, info)
    if edit_message is not None:
        try:
            await edit_message.edit_text(html, parse_mode=ParseMode.HTML,
                                         reply_markup=kb, disable_web_page_preview=True)
            return edit_message
        except Exception:
            try:
                await edit_message.delete()
            except Exception:
                pass
    return await bot.send_message(chat_id, html, parse_mode=ParseMode.HTML,
                                  reply_markup=kb, disable_web_page_preview=True)


async def screen_tracking_card(message: Message, tid: str, info: dict) -> None:
    """SCREEN 1 — send the tracking card for one package."""
    sent = await _deliver_card(message.bot, message.chat.id, tid, info)
    _expire(sent)


def _expire(sent: Optional[Message], ttl: Optional[int] = None) -> None:
    """Same deletion rule as every data-bearing message in this bot."""
    seconds = config.EPHEMERAL_TTL if ttl is None else ttl
    if sent is not None and seconds > 0:
        task = asyncio.create_task(ui._delete_later(sent.chat.id, sent.message_id, seconds))
        ui._pending_deletes.add(task)
        task.add_done_callback(ui._pending_deletes.discard)


@router.callback_query(F.data.startswith("sc1:"))
async def callback_card(callback: CallbackQuery):
    _, action, tid = callback.data.split(":", 2)
    chat_id = callback.message.chat.id
    info = _packages(chat_id).get(tid)
    if info is None:
        await callback.answer("Package not found", show_alert=True)
        return
    if action == "m":
        if not await ui.can_manage_package(ui.FakeMessage(callback), tid):
            await callback.answer("No permission", show_alert=True)
            return
        info["muted"] = not info.get("muted")
        _save()
        await _deliver_card(callback.bot, chat_id, tid, info, edit_message=callback.message)
        await callback.answer("Notifications muted" if info["muted"] else "Notifications on")
        return
    # Refresh: updating is the global loop's job (cadence, quota). The tap pulls
    # this package's next look forward through the same throttled hook the
    # 17TRACK webhook uses, and re-draws what is stored right now.
    import refresh
    counts = refresh.mark_due_now(tid)
    await _deliver_card(callback.bot, chat_id, tid, info, edit_message=callback.message)
    await callback.answer("Checking now…" if counts.get("matched")
                          else "Already up to date")


# ═══════════════════════════════════════════════════════════════════════════
# 2. PACKAGE LIST
# ═══════════════════════════════════════════════════════════════════════════
FILTERS = ("active", "delivered", "archive")


def _in_filter(info: dict, which: str, now: Optional[datetime] = None) -> bool:
    delivered = info.get("status") == "Delivered"
    if which == "active":
        return not delivered
    if not delivered:
        return False
    age = _age_days(info.get("last_updated"), now)
    old = age is not None and age > ARCHIVE_AFTER_DAYS
    return old if which == "archive" else not old


def package_list_text(packages: Dict[str, dict], which: str,
                      now: Optional[datetime] = None) -> str:
    rows = [(tid, info) for tid, info in ui.sort_packages(packages)
            if _in_filter(info, which, now)]
    title = {"active": "Your packages", "delivered": "Delivered", "archive": "Archive"}[which]
    if not rows:
        return f"\U0001f4e6 <b>{title}</b>\n\n<i>Nothing here.</i>"
    count = f"{len(rows)} active" if which == "active" else str(len(rows))
    lines = [f"\U0001f4e6 <b>{title}</b> · {count}", ""]
    for _tid, info in rows:
        name = escape((info.get("name") or "").strip() or "Unnamed")
        lines.append(f"{escape(status_pill(info, now))}  <b>{name}</b>\n"
                     f"      <i>{escape(package_subline(info, now))}</i>")
    return "\n".join(lines)


def package_list_keyboard(which: str) -> InlineKeyboardMarkup:
    def tab(key: str, label: str) -> InlineKeyboardButton:
        return InlineKeyboardButton(text=f"• {label}" if key == which else label,
                                    callback_data=f"sc2:f:{key}")
    return InlineKeyboardMarkup(inline_keyboard=[
        [tab("active", "Active"), tab("delivered", "Delivered"), tab("archive", "Archive")],
        [InlineKeyboardButton(text="➕ Add package", callback_data="sc2:add"),
         InlineKeyboardButton(text="\U0001f4f7 Scan label", callback_data="sc2:scan")],
    ])


async def screen_package_list(message: Message, which: str = "active") -> None:
    """SCREEN 2 — the roster with status pills and filters."""
    which = which if which in FILTERS else "active"
    packages = _packages(ui.get_chat_id(message))
    await _send(message, package_list_text(packages, which), package_list_keyboard(which))


@router.callback_query(F.data.startswith("sc2:"))
async def callback_list(callback: CallbackQuery):
    parts = callback.data.split(":")
    chat_id = callback.message.chat.id
    if parts[1] == "f":
        which = parts[2] if parts[2] in FILTERS else "active"
        await ui.safe_edit_text(
            callback.message, package_list_text(_packages(chat_id), which),
            parse_mode=ParseMode.HTML, reply_markup=package_list_keyboard(which))
        await callback.answer()
    elif parts[1] == "add":
        await callback.message.answer(
            "➕ Send me a tracking number and I'll take it from there.")
        await callback.answer()
    else:
        await callback.message.answer(
            "\U0001f4f7 Send a photo of the shipping label — I'll read the number off it.")
        await callback.answer()


# ═══════════════════════════════════════════════════════════════════════════
# 3. DELIVERY ALERT (+ follow-up)
# ═══════════════════════════════════════════════════════════════════════════
def delivery_alert_text(tid: str, info: dict) -> str:
    name = escape(info.get("name") or "Your package")
    carrier = escape(info.get("carrier_name") or "")
    sub = f"{name} · {carrier}" if carrier else name
    time_range = delivery_time_range(info)
    window = delivery_window(info)
    if time_range:
        big = f"<b>{escape(time_range)}</b>"
    elif window:
        big = f"<b>Arriving {escape(window)}</b>"
    else:
        big = "<b>Arriving today</b>"
    bar = progress_bar(info.get("status") or "Out for Delivery")
    return (f"\U0001f69a <b>Out for delivery</b>   \U0001f7e2 Today\n{sub}\n\n"
            f"{big}\n<code>{bar}</code>")


def delivery_alert_keyboard(tid: str, info: Optional[dict] = None) -> InlineKeyboardMarkup:
    # `style` is the Bot API 10.x button colour: success = green, danger = red.
    rows = [[
        InlineKeyboardButton(text="✅ Got it", callback_data=f"sc3:ok:{tid}", style="success"),
        InlineKeyboardButton(text="\U0001f6aa Not home", callback_data=f"sc3:nh:{tid}", style="danger"),
    ]]
    coords = last_scan_coordinates(info) if info else None
    if coords:
        # No carrier feed gives a driver position, so this opens the last scan.
        url = (f"https://www.openstreetmap.org/?mlat={coords[0]:.5f}"
               f"&mlon={coords[1]:.5f}#map=13/{coords[0]:.5f}/{coords[1]:.5f}")
        rows.append([InlineKeyboardButton(text="\U0001f5fa Last scan on map", url=url)])
    return InlineKeyboardMarkup(inline_keyboard=rows)


async def screen_delivery_alert(message: Message, tid: str, info: dict) -> None:
    """SCREEN 3a — the big delivery-window headline with Got it / Not home."""
    await _send(message, delivery_alert_text(tid, info), delivery_alert_keyboard(tid, info))


def delivered_followup_text(info: dict) -> str:
    name = escape(info.get("name") or "Your package")
    if info.get("not_home"):
        return (f"\U0001f4e6 <b>{name}</b> was delivered while you were out.\n"
                "Check your porch, mailbox or front desk.")
    dt = _parse_iso(info.get("last_updated"))
    at = f" · {dt:%-I:%M %p}" if dt else ""
    return f"✅ <b>Delivered</b>\n{name}{at}"


async def screen_delivered_followup(message: Message, tid: str, info: dict) -> None:
    """SCREEN 3b — the follow-up 'Delivered' message."""
    await _send(message, delivered_followup_text(info), None)


@router.callback_query(F.data.startswith("sc3:"))
async def callback_alert(callback: CallbackQuery):
    _, action, tid = callback.data.split(":", 2)
    info = _packages(callback.message.chat.id).get(tid)
    if info is None:
        await callback.answer("Package not found", show_alert=True)
        return
    # Like the Porch Guard "Got it": no permission check — whoever taps is the
    # person at the door, and all it changes is a note on the record.
    info["not_home"] = (action == "nh")
    _save()
    name = escape(info.get("name") or "Your package")
    await ui.safe_edit_text(
        callback.message,
        f"✅ Noted — <b>{name}</b>: you'll be there." if action == "ok"
        else f"\U0001f6aa Noted — <b>{name}</b>: nobody home. I'll tell you the moment it's delivered.",
        parse_mode=ParseMode.HTML)
    await callback.answer("Got it" if action == "ok" else "Marked not home")


# ═══════════════════════════════════════════════════════════════════════════
# 4. ADD BY PASTING A NUMBER
# ═══════════════════════════════════════════════════════════════════════════
NAME_SUGGESTIONS = ("Phone case", "Gift", "Work")
_ADD_TTL = 900.0
# chat_id -> draft. In memory on purpose (UI state, like the rename prompt).
_drafts: Dict[int, dict] = {}
# Carriers offered by "Wrong carrier" — from carriers.CARRIER_NAMES, trimmed.
_CARRIER_CHOICES = ("ups", "usps", "fedex", "dhl", "ontrac", "canadapost")


def _draft(chat_id: int) -> Optional[dict]:
    draft = _drafts.get(chat_id)
    if draft and draft["deadline"] < time.monotonic():
        _drafts.pop(chat_id, None)
        return None
    return draft


def add_number_text(draft: dict) -> str:
    carrier = escape(draft["carrier_name"])
    lines = ["\U0001f50e <b>Carrier detected</b>",
             f"Looks like <b>{carrier}</b>. Name this package?",
             "", f"Carrier: <b>{carrier}</b>", "Status: <b>Found</b>"]
    if draft.get("name"):
        lines.append(f"Name: <b>{escape(draft['name'])}</b>")
    return "\n".join(lines)


def add_number_keyboard(draft: dict) -> InlineKeyboardMarkup:
    names = [InlineKeyboardButton(
        text=("✓ " if draft.get("name") == n else "") + n, callback_data=f"sc4:n:{i}")
        for i, n in enumerate(NAME_SUGGESTIONS)]
    return InlineKeyboardMarkup(inline_keyboard=[
        names,
        [InlineKeyboardButton(text="✏️ Custom name", callback_data="sc4:c"),
         InlineKeyboardButton(text="↪️ Wrong carrier", callback_data="sc4:w")],
        [InlineKeyboardButton(text="▶️ Start tracking", callback_data="sc4:s",
                              style="primary")],
    ])


async def screen_add_by_number(message: Message, number: str) -> bool:
    """SCREEN 4 — detect the carrier for a pasted number and offer names.
    Returns False (and sends nothing) when the text is not a tracking number."""
    tids, _ = ui.parse_track_args(number, has_command=False)
    if len(tids) != 1:
        return False
    tid = tids[0]
    carrier = carriers.detect_carrier(tid)
    chat_id = ui.get_chat_id(message)
    draft = {"tid": tid, "carrier": carrier["code"], "carrier_name": carrier["name"],
             "name": None, "user_id": message.from_user.id if message.from_user else 0,
             "deadline": time.monotonic() + _ADD_TTL, "awaiting_name": False}
    _drafts[chat_id] = draft
    await _send(message, add_number_text(draft), add_number_keyboard(draft), ttl=_ADD_TTL)
    return True


def take_custom_name(chat_id: int, user_id: int, text: str) -> Optional[dict]:
    """Called by the message handler: if this chat is waiting for a custom name
    from this user, consume the message as that name. Returns the draft or None."""
    draft = _draft(chat_id)
    if not draft or not draft.get("awaiting_name") or draft["user_id"] != user_id:
        return None
    draft["name"] = " ".join(text.split())[:40] or None
    draft["awaiting_name"] = False
    return draft


async def apply_custom_name(message: Message) -> bool:
    """Hook for main.unknown_handler: when this chat is waiting for a screen-4
    custom name from this user, take the message as the name and redraw the
    screen. Inert (returns False) otherwise, so it cannot affect other messages."""
    if not message.text or message.text.startswith("/"):
        return False
    user_id = message.from_user.id if message.from_user else 0
    draft = take_custom_name(ui.get_chat_id(message), user_id, message.text)
    if draft is None:
        return False
    await _send(message, add_number_text(draft), add_number_keyboard(draft), ttl=_ADD_TTL)
    return True


@router.callback_query(F.data.startswith("sc4:"))
async def callback_add(callback: CallbackQuery):
    parts = callback.data.split(":")
    chat_id = callback.message.chat.id
    draft = _draft(chat_id)
    if draft is None:
        await callback.answer("That prompt expired — paste the number again.", show_alert=True)
        return
    if parts[1] == "n":
        draft["name"] = NAME_SUGGESTIONS[int(parts[2])]
    elif parts[1] == "c":
        draft["awaiting_name"] = True
        await callback.message.answer("✏️ Reply with a name for this package.",
                                      reply_markup=ForceReply(selective=True))
        await callback.answer()
        return
    elif parts[1] == "w":
        rows = [[InlineKeyboardButton(text=carriers.CARRIER_NAMES.get(slug, slug),
                                      callback_data=f"sc4:k:{slug}")]
                for slug in _CARRIER_CHOICES]
        await ui.safe_edit_text(callback.message, "Which carrier is it?",
                                reply_markup=InlineKeyboardMarkup(inline_keyboard=rows))
        await callback.answer()
        return
    elif parts[1] == "k":
        slug = parts[2]
        draft["carrier"], draft["carrier_name"] = slug, carriers.CARRIER_NAMES.get(slug, slug)
    elif parts[1] == "s":
        _drafts.pop(chat_id, None)
        import main as bot_main                    # lazy: main imports this module
        await callback.answer("Tracking…")
        await bot_main._add_packages(ui.FakeMessage(callback), [draft["tid"]],
                                     custom_name=draft.get("name"))
        return
    await ui.safe_edit_text(callback.message, add_number_text(draft),
                            parse_mode=ParseMode.HTML, reply_markup=add_number_keyboard(draft))
    await callback.answer()


# ═══════════════════════════════════════════════════════════════════════════
# 5. SETTINGS
# ═══════════════════════════════════════════════════════════════════════════
_SETTINGS_FILE = "chat_settings.json"
# (key, label, which statuses it governs). Defaults reproduce today's behaviour:
# every status change pings, so a chat that never opens Settings sees no change.
TOGGLES = (
    ("ofd", "Out for delivery"),
    ("delivered", "Delivered"),
    ("scans", "Every scan update"),
    ("problems", "Delays and problems"),
)
_DEFAULTS = {"ofd": True, "delivered": True, "scans": True, "problems": True,
             "quiet": False}
_settings_cache: Optional[Dict[str, dict]] = None


def _settings_path() -> Path:
    return Path(_SETTINGS_FILE)


def _load_all() -> Dict[str, dict]:
    global _settings_cache
    if _settings_cache is None:
        data: Dict[str, dict] = {}
        path = _settings_path()
        if path.exists():
            try:
                text, _enc = storage._read_protected(path)
                data = json.loads(text) if text else {}
            except (ValueError, TypeError, OSError):
                logger.warning("Could not read chat settings; using defaults")
        _settings_cache = data if isinstance(data, dict) else {}
    return _settings_cache


def get_settings(chat_id: int) -> dict:
    merged = dict(_DEFAULTS)
    stored = _load_all().get(str(chat_id)) or {}
    merged.update({k: bool(v) for k, v in stored.items() if k in _DEFAULTS})
    return merged


def set_setting(chat_id: int, key: str, value: bool) -> None:
    if key not in _DEFAULTS:
        raise KeyError(key)
    allv = _load_all()
    allv.setdefault(str(chat_id), {})[key] = bool(value)
    try:
        storage._write_protected(_settings_path(), json.dumps(allv))
    except OSError as exc:
        logger.warning("Could not save chat settings: %s", exc)


def _in_quiet_hours(now: Optional[datetime] = None) -> bool:
    hour = (now or datetime.now()).hour               # server-local time
    if QUIET_START_HOUR > QUIET_END_HOUR:
        return hour >= QUIET_START_HOUR or hour < QUIET_END_HOUR
    return QUIET_START_HOUR <= hour < QUIET_END_HOUR


def notify_allowed(chat_id: int, status: Optional[str],
                   now: Optional[datetime] = None) -> bool:
    """Should a status change ping this chat? Used by refresh. Defaults say yes
    to everything; a delivery always pings through quiet hours (a delivered
    parcel is still on the porch — same rule as muted packages)."""
    cfg = get_settings(chat_id)
    if status == "Delivered":
        return cfg["delivered"]
    if cfg["quiet"] and _in_quiet_hours(now):
        return False
    if status == "Out for Delivery":
        return cfg["ofd"]
    if status in ("Exception", "Delivery Attempted"):
        return cfg["problems"]
    return cfg["scans"]


def _hour12(hour: int) -> str:
    return f"{(hour % 12) or 12} {'AM' if hour < 12 else 'PM'}"


def settings_text(chat_id: int) -> str:
    cfg = get_settings(chat_id)
    quiet = (f"{_hour12(QUIET_START_HOUR)} to {_hour12(QUIET_END_HOUR)}"
             if cfg["quiet"] else "Off")
    return ("⚙️ <b>Notifications</b>\n"
            "Tap a row to switch it on or off.\n\n"
            "Muted packages still ping for deliveries and problems.\n"
            f"Quiet hours: <b>{quiet}</b> <i>(bot's local time; deliveries still ping)</i>")


def settings_keyboard(chat_id: int) -> InlineKeyboardMarkup:
    cfg = get_settings(chat_id)
    rows = [[InlineKeyboardButton(
        text=f"{label}: {'On' if cfg[key] else 'Off'}",
        callback_data=f"sc5:t:{key}",
        style="success" if cfg[key] else None)] for key, label in TOGGLES]
    quiet = (f"{_hour12(QUIET_START_HOUR)} to {_hour12(QUIET_END_HOUR)}"
             if cfg["quiet"] else "Off")
    rows.append([InlineKeyboardButton(
        text=f"\U0001f319 Quiet hours: {quiet}", callback_data="sc5:t:quiet")])
    rows.append([InlineKeyboardButton(text="✔️ Done", callback_data="sc5:done",
                                      style="primary")])
    return InlineKeyboardMarkup(inline_keyboard=rows)


async def screen_settings(message: Message) -> None:
    """SCREEN 5 — full-width toggles; the message edits itself on each tap."""
    await _send(message, settings_text(message.chat.id),
                settings_keyboard(message.chat.id), ttl=0)


@router.callback_query(F.data.startswith("sc5:"))
async def callback_settings(callback: CallbackQuery):
    chat_id = callback.message.chat.id
    parts = callback.data.split(":")
    if parts[1] == "done":
        await ui.safe_edit_text(callback.message, "✅ Settings saved.")
        await callback.answer()
        return
    key = parts[2]
    if key not in _DEFAULTS:
        await callback.answer("Unknown setting", show_alert=True)
        return
    if callback.message.chat.type != ChatType.PRIVATE and not await ui.is_admin(
            ui.FakeMessage(callback)):
        await callback.answer("Only admins can change this", show_alert=True)
        return
    set_setting(chat_id, key, not get_settings(chat_id)[key])
    await ui.safe_edit_text(callback.message, settings_text(chat_id),
                            parse_mode=ParseMode.HTML, reply_markup=settings_keyboard(chat_id))
    await callback.answer()


# ═══════════════════════════════════════════════════════════════════════════
# 6. MINI APP BUTTON
# ═══════════════════════════════════════════════════════════════════════════
def miniapp_button() -> Optional[MenuButtonWebApp]:
    if not config.MINI_APP_URL:
        return None
    return MenuButtonWebApp(text="\U0001f4e6 Packages",
                            web_app=WebAppInfo(url=config.MINI_APP_URL))


async def screen_miniapp_button(message: Message) -> bool:
    """SCREEN 6 — put a bottom 'Packages' button in THIS chat that opens the
    Mini App's full package list. Private chats only (Telegram requirement), and
    per chat: the bot-wide default stays the plain menu button set at startup.

    No driver position or 'stops away' is offered anywhere in the app or here:
    17TRACK does not return either (see the module docstring)."""
    button = miniapp_button()
    if button is None or message.chat.type != ChatType.PRIVATE:
        await _send(message, "The Packages button needs the Mini App enabled and a private chat.", None)
        return False
    await message.bot.set_chat_menu_button(chat_id=message.chat.id, menu_button=button)
    await _send(message, "\U0001f4e6 Done — the <b>Packages</b> button at the bottom now opens "
                "your full package list.", None)
    return True


# ═══════════════════════════════════════════════════════════════════════════
# Owner preview: /screens 1..6 — shows each screen with a real or sample package
# ═══════════════════════════════════════════════════════════════════════════
_SAMPLE_TID = "SAMPLE0000001"


def _sample_info() -> dict:
    now = datetime.now(timezone.utc)
    iso = lambda days: (now - timedelta(days=days)).isoformat()    # noqa: E731
    return {
        "name": "Phone case", "carrier_name": "UPS", "status": "Out for Delivery",
        "last_updated": iso(0), "last_event_at": iso(0), "muted": False,
        "eta": {"from": (now + timedelta(hours=2)).isoformat(),
                "to": (now + timedelta(hours=4)).isoformat(), "source": "Official"},
        "events": [
            {"t": iso(0), "d": "Out for delivery", "l": "Austin, TX"},
            {"t": iso(0.4), "d": "Arrived at facility", "l": "Austin, TX",
             "lat": 30.2672, "lon": -97.7431},
            {"t": iso(1.2), "d": "Departed facility", "l": "Dallas, TX"},
            {"t": iso(2.1), "d": "Origin scan", "l": "Dallas, TX"},
        ],
    }


@router.message(Command("screens"))
async def screens_preview(message: Message):
    if not await ui.is_admin(message):
        return
    arg = (message.text or "").split(maxsplit=1)[1:] or [""]
    which = arg[0].strip()
    chat_id = ui.get_chat_id(message)
    real = list(_packages(chat_id).items())
    tid, info = real[0] if real else (_SAMPLE_TID, _sample_info())
    if which == "1":
        await screen_tracking_card(message, tid, info if real else _sample_info())
    elif which == "3":
        await screen_delivery_alert(message, tid, info)
        await screen_delivered_followup(message, tid, info)
    elif which == "5":
        await screen_settings(message)
    else:
        await message.answer("Usage: /screens 1, 3 or 5")
