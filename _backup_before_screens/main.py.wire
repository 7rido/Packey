@router.message(Command("cancel"))
async def cancel_handler(message: Message):
    chat_id = get_chat_id(message)
    cancelled = False
    for key in list(pending_confirmations):
        if key[0] == chat_id and key[1] in ("add", "remove", "purge", "clear"):
            del pending_confirmations[key]
            cancelled = True
    if cancelled:
        await send_ephemeral(message, "\u2705 Cancelled \u2014 nothing changed.")
    else:
        await send_ephemeral(message, "Nothing to cancel.")


# ── /ping — operator broadcast ──────────────────────────────────────────────
# Admin-only, and deliberately NOT confirmed: the operator asked for the text to
# go out the moment it is sent (2026-09-26). What is left are the guards that stop
# accidents rather than ask questions — the command is registered only in the
# operator's own menu, a cooldown blocks a double-tap or a retry loop, sends are
# paced under Telegram's ceiling, and every recipient is counted back so a mistake
# is visible immediately.
_PING_MIN_GAP = 300.0
# None = "never sent", not 0.0: time.monotonic() is process-relative on this
# platform, so a fresh process starts near zero and every first /ping looked like
# it was inside the cooldown (measured: 1.9s). Same trap refresh.py documents.
_ping_last_sent: Optional[float] = None


def _ping_targets(exclude: Optional[int] = None) -> List[int]:
    """Every chat the bot knows: holds packages, or is Pro. Never the caller."""
    chats = set(track_sessions) | set(_pro_users)
    if exclude is not None:
        chats.discard(exclude)
    return sorted(chats)


@router.message(Command("ping"))
async def ping_handler(message: Message):
    global _ping_last_sent
    chat_id = get_chat_id(message)
    if chat_id not in OWNER_CHAT_IDS:
        return                 # silent on purpose: users never learn it exists
    args = (message.text or "").split(maxsplit=1)
    targets = _ping_targets(exclude=chat_id)
    text = args[1].strip() if len(args) > 1 else ""

    if not text:
        await send_ephemeral(
            message,
            f"\U0001f4e3 <b>Broadcast</b> \u2014 <b>{len(targets)}</b> chat(s) "
            "would receive it (\u2248 "
            f"{max(1, round(len(targets) / 20))}s to send).\n"
            "<code>/ping your message</code> sends it to all of them right away, "
            "as plain text \u2014 there is no confirmation step.",
            parse_mode=ParseMode.HTML)
        return

    if len(text) > 4096:
        await send_ephemeral(message, "\u274c Too long \u2014 Telegram caps one "
                                      "message at 4096 characters.")
        return

    # Paste-guard: /ping delivers to EVERY chat, so a chat ID or a tracking number
    # pasted into the text would be broadcast to all of them. Both look like a long
    # digit run; rewording (a comma, a word between the digits) clears the check.
    if re.search(r"\d{9,}", text):
        keep_input(message)
        await send_ephemeral(
            message,
            "\U0001f6d1 That text contains a long digit run \u2014 it looks like a "
            "chat ID or a tracking number, and /ping delivers to every chat. Edit "
            "it (a comma or a word between the digits is enough) and send again.",
            parse_mode=ParseMode.HTML)
        return

    now = time.monotonic()
    if _ping_last_sent is not None and now - _ping_last_sent < _PING_MIN_GAP:
        await send_ephemeral(
            message,
            f"\u23f3 The last broadcast went out {int(now - _ping_last_sent)}s ago "
            f"\u2014 wait {int(_PING_MIN_GAP - (now - _ping_last_sent)) + 1}s before "
            "sending another.",
            parse_mode=ParseMode.HTML)
        return
    # Stamped before the loop: a crash halfway through must not let a retry send
    # the whole thing a second time to everyone who already got it.
    _ping_last_sent = now

    if botstate.bot is None:
        await send_ephemeral(message, "\u274c No live Bot handle \u2014 nothing sent.")
        return

    sent = blocked = failed = 0
    for target in targets:
        try:
            await botstate.bot.send_message(target, text)
            sent += 1
        except Exception as e:
            # 403 = they blocked the bot. Normal, and not something to act on.
            if "blocked" in str(e).lower() or "forbidden" in str(e).lower():
                blocked += 1
            else:
                failed += 1
                logger.info("Broadcast could not reach a chat: %s", type(e).__name__)
        await asyncio.sleep(0.05)   # ~20/s, comfortably under Telegram's ~30/s
    logger.info("Operator broadcast: sent=%d blocked=%d failed=%d", sent, blocked, failed)
    # Persistent on purpose (not send_ephemeral): the counts are the point, and
    # they hold no identifiers — only how many chats took the message.
    await message.answer(
        f"\U0001f4e3 Sent to <b>{sent}</b> \u00b7 blocked <b>{blocked}</b> \u00b7 "
        f"failed <b>{failed}</b> \u00b7 of {len(targets)} target(s).",
        parse_mode=ParseMode.HTML)


