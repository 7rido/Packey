# ──────────────────────────────────────────────
# Chat-side tidy-up: the message the bot ran on does not stay in history
# ──────────────────────────────────────────────
# The bot's own messages that carry package data are ephemeral (ui.send_ephemeral),
# but the user's side was not: a /track line, a pasted number or a label photo sat
# in chat history forever — and chat history is the one store we don't control,
# group history especially. So a message is deleted once it has been recognized and
# run: a bot command, a photo, or any text carrying a tracking number (a pasted
# number is precisely what /forget's reasoning says must not linger).
#
# Three deliberate exclusions. Ordinary chat in a group is left alone — this deletes
# what the bot acted on, not the conversation. A message the bot did NOT act on
# (a usage reply, an unreadable photo, an unknown command) stays, so the user can
# read what they sent and fix it rather than wonder where it went — handlers mark
# those with keep_input(). And a run that raised also leaves the message.
# The ☰ menu: (command, description) — ONE source of truth. Three things read it:
# the global menu (built from it in main()), the operator's menu (/ping added ON
# TOP of it — a chat-scoped menu REPLACES the default one, Telegram does not merge
# scopes, so the first version registered only /ping and the operator's menu lost
# the other thirteen commands), and the tidy middleware's MENU_COMMANDS below.
MENU_ITEMS = (
    ("track", "Add packages"),
    ("list", "Show all packages"),
    ("info", "One package's card"),
    ("name", "Rename a package"),
    ("mute", "Mute or unmute a package"),
    ("remove", "Remove a package"),
    ("forget", "Remove a package without its number"),
    ("purge", "Remove delivered packages"),
    ("clear", "Remove all packages"),
    ("status", "Bot health & stats"),
    ("privacy", "Privacy & data policy"),
    ("cancel", "Cancel a pending action"),
    ("help", "Help & examples"),
)
MENU_COMMANDS = frozenset(
    [name for name, _ in MENU_ITEMS]
    # Handler aliases that share a command but have no menu row of their own,
    # plus /start (handled, deliberately absent from the menu) and /ping
    # (operator-only, layered onto the operator's menu).
    + ["start", "add", "packages", "rename", "unmute", "ping"])

_KEEP_INPUT_MAX = 500
_keep_input: Set[Tuple[int, int]] = set()

# The backup watchdog: hours after which the newest archive counts as stale, and
# the directory it watches (run.sh and the launchd job both write here).
_BACKUP_STALE_HOURS = 48
_BACKUP_DIR = Path.home() / "Backups" / "packey"


async def check_backup_staleness() -> None:
    """The backup watchdog: the backup script alerts when a run FAILS, but nothing
    alerts when the job never RUNS (the Mac asleep through every scheduled
    window). Stale hours — or no archive at all — means 'not being backed up'.
    Called at startup; see _BACKUP_STALE_HOURS for the threshold."""
    stale = _backup_stale_hours(_BACKUP_DIR)
    if stale is None:
        await botstate.notify_admins(
            "⚠️ No backup archive was found in ~/Backups/packey — the backup job "
            "has never produced one, or the directory moved. Run "
            "./scripts/backup_state.sh to take a snapshot.", key="backup-stale")
    elif stale > _BACKUP_STALE_HOURS:
        await botstate.notify_admins(
            f"⚠️ The newest backup archive is {stale:.0f} h old — the scheduled "
            "backup job may not be running (asleep through every window?). Run "
            "./scripts/backup_state.sh manually or check backup.log.",
            key="backup-stale")


def _backup_stale_hours(backup_dir: Path) -> Optional[float]:
    """Hours since the newest backup archive, or None when there is none — both
    mean 'this machine is not being backed up right now'."""
    try:
        archives = list(backup_dir.glob("*.tar.enc"))
    except OSError:
        return None
    if not archives:
        return None
    newest = max(a.stat().st_mtime for a in archives)
    return (time.time() - newest) / 3600.0


def keep_input(message: Message) -> None:
    """Mark a message as 'not acted on': the tidy middleware must leave it in place."""
    _keep_input.add((message.chat.id, message.message_id))
    if len(_keep_input) > _KEEP_INPUT_MAX:
        # Crude bound; the current message is re-added so it is never the victim.
        _keep_input.clear()
        _keep_input.add((message.chat.id, message.message_id))


def _is_bot_input(message: Message) -> bool:
    """True for the messages this bot is expected to act on."""
    if message.photo:
        return True          # handlers keep_input() when they cannot read one
    text = (message.text or "").strip()
    if not text:
        return False
    if text.startswith("/"):
        # Only OUR commands count: an unknown /word is not one of ours, and
        # /cmd@otherbot is aimed at another bot — both stay in the chat.
        first = text.split()[0] if text.split() else ""
        cmd = first[1:].split("@", 1)[0].lower()
        return cmd in MENU_COMMANDS
    return bool(parse_track_args(text, has_command=False)[0])


@router.message.outer_middleware()
async def tidy_user_message(handler, event: Message, data):
    """Run the handler first, then clear the message it acted on."""
    result = await handler(event, data)
    if _is_bot_input(event) and (event.chat.id, event.message_id) not in _keep_input:
        try:
            await event.delete()
        except Exception as e:
            # A group needs the "delete messages" right for this, and Telegram
            # refuses messages that are already too old — neither may break the
            # command the user actually asked for.
            logger.debug("Could not delete the handled message: %s", type(e).__name__)
    return result


_recent_starts: Dict[Tuple[int, int], float] = {}
_start_last_response: Dict[int, float] = {}
START_THROTTLE_SECONDS = 60  # max one /start greeting per chat per minute


def _start_seen(chat_id: int, message_id: int) -> bool:
    """True if this exact /start message was already answered. Telegram can
    redeliver an update (e.g. the bot restarted before acknowledging it),
    which made /start greet twice; this guards against that."""
    now = time.monotonic()
    for key, ts in list(_recent_starts.items()):
        if now - ts > 600:
            _recent_starts.pop(key, None)
    key = (chat_id, message_id)
    if key in _recent_starts:
        return True
    _recent_starts[key] = now
    return False


# /start is deliberately silent: the button does the talking.

@router.message(Command("start"))
async def start_handler(message: Message):
    chat_id = get_chat_id(message)
    # No username: a handle names a person, and the log is the one file that is
    # never meant to hold one. The masked chat tag is enough to follow a story.
    logger.info("START cmd from chat=%s msg_id=%s",
                storage.mask_chat(chat_id), message.message_id)
    if _start_seen(chat_id, message.message_id):
        logger.info("START duplicate suppressed (chat=%s msg_id=%s) — deleting",
                    storage.mask_chat(chat_id), message.message_id)
        try:
            await message.delete()
        except Exception as e:
            logger.debug("Could not delete duplicate /start: %s", e)
        return  # duplicate delivery — already greeted once
    # Time-based throttle: Telegram's iOS client can auto-send /start twice
    # (two distinct messages, milliseconds apart) when the bot is opened.
    # Record BEFORE the await so a concurrent duplicate can't slip through.
    now = time.monotonic()
    # Same self-prune as _recent_starts above, for the same reason: this table
    # is keyed by chat and nothing ever removed a key, so it grew for the life
    # of the process. An entry older than the throttle window is
    # indistinguishable from "never greeted" (the check below only ever reads
    # `now - last` against START_THROTTLE_SECONDS), so dropping it cannot change
    # whether this greeting is sent.
    for cid, ts in list(_start_last_response.items()):
        if now - ts > START_THROTTLE_SECONDS:
            _start_last_response.pop(cid, None)
    # `last is None` means "never greeted" — NOT "greeted at clock zero". Using
    # 0.0 as the default made a fresh chat look like a duplicate whenever the
    # monotonic clock happens to be small (e.g. right after boot), and the
    # greeting was then deleted as spam.
    last = _start_last_response.get(chat_id)
    if last is not None and now - last < START_THROTTLE_SECONDS:
        logger.warning("START throttled: chat=%s sent duplicate after %.0fs — deleting",
                       storage.mask_chat(chat_id), now - last)
        try:
            await message.delete()
        except Exception as e:
            logger.debug("Could not delete throttled /start: %s", e)
        return
    _start_last_response[chat_id] = now
    logger.info("START processing: chat=%s (last greeting was %.0fs ago)",
                storage.mask_chat(chat_id), now - last if last is not None else -1)
    is_group = message.chat.type in (ChatType.GROUP, ChatType.SUPERGROUP)
    # Every number here is derived from config or the cadence table — copy that
    # hardcodes a schedule drifts the moment the schedule changes.
    # Every number below is read from config at call time, so an operator who
    # edits .env cannot leave the greeting advertising the old figure. The
    # cadence values (refresh.CADENCE) are deliberately NOT quoted: "faster
    # checks" is what the pitch now says, and /help carries the schedule.
    retention_line = (
        f"• Delivered packages are forgotten after {config.RETENTION_DAYS} days; "
        f"<code>/forget</code> removes one sooner\n"
        if config.RETENTION_DAYS > 0 else
        "• Delivered packages stay until you delete them\n")
    # What SURVIVES the package, stated rather than left implied. The pitch above
    # says a number is forgotten after RETENTION_DAYS, and a reader could
    # reasonably conclude everything is — three small records outlive it, none of
    # them holding a tracking number. Built from the live values like the lines
    # above, and only when retention is actually on: with it off, "kept N days"
    # would be a lie.
    outlives_line = (
        "• A few small records outlive the package — your Pro payment records, "
        "your reserved payment address, and a record of the international "
        "packages you've registered this period (which holds those numbers, so "
        "re-adding one is free); "
        "<code>/privacy</code> lists them\n"
        if config.RETENTION_DAYS > 0 else "")
    # The price the bot actually sells, quoted per week when the term divides
    # evenly (7 days reads as "$1 per week", not "$1 per 7 days") and as days
    # otherwise. Never hardcoded: an owner who edits PRO_PRICE_USD or
    # SUBSCRIPTION_DAYS must not leave the greeting advertising the old figure.
    def _price() -> str:
        amount = f"{config.PRO_PRICE_USD:g}"
        days = config.SUBSCRIPTION_DAYS
        if days == 7:
            return f"${amount} per week"
        if days % 7 == 0 and days >= 7:
            return f"${amount} per {days // 7} weeks"
        return f"${amount} per {days} days"
    text = (
        "\U0001f4e6 <b>Packey</b> \u2014 Your packages, none of our business.\n\n"
        "Send a tracking number. I detect the carrier and ping you when the "
        "status changes. No account, no refresh buttons.\n\n"

        "<b>\U0001f512 Privacy by default</b>\n"
        "• Pings never include your tracking number, your name, or what's "
        "inside \u2014 groups included\n"
        + retention_line +
        "• Encrypted at rest (AES + HMAC) \u00b7 logs mask identifiers\n"
        + outlives_line + "\n"

        "<b>\U0001f193 FREE</b> \u2014 "
        f"{FREE_PACKAGE_LIMIT} packages \u00b7 send a photo of the barcode \u00b7 "
        "Porch Guard delivery alerts\n"

        "<b>\U0001f31f PRO</b> \u2014 "
        f"{PRO_PACKAGE_LIMIT} packages, faster checks, 3,000+ carriers, "
        "the \U0001f30d International tab for national posts "
        f"({PRO_INTL_LIMIT} international package"
        f"{'s' if PRO_INTL_LIMIT != 1 else ''}), in/out "
        f"direction, haptics &amp; themes \u2014 "
        f"{_price()}\n\n"

        "Privacy: /privacy \u00b7 Help: /help"
    )
    if is_group:
        text += (
            "\n\n\U0001f465 <b>Group mode active</b>\n"
            "\u2022 Everyone can add packages\n"
            "\u2022 Only admins (or original adder) can rename/remove\n"
            "\u2022 Only admins can use /clear"
        )
    kwargs = {}
    if MINI_APP_URL and not is_group:
        kwargs["reply_markup"] = InlineKeyboardMarkup(inline_keyboard=[[
            InlineKeyboardButton(text="Open the app", web_app=WebAppInfo(url=MINI_APP_URL)),
        ]])
    await message.answer(text, parse_mode=ParseMode.HTML, **kwargs)


@router.message(Command("privacy"))
async def privacy_handler(message: Message):
    """What the bot does with package data, in the owner's own words. Kept
    honest about the limits (Telegram the platform, public blockchains) — the
    claims a user can check are pinned by tests/test_privacy.py.

    The text itself lives in ui.PRIVACY_TEXT so the Mini App's privacy sheet
    (GET /api/privacy) cannot drift away from what /privacy promises here.

    Sent as several messages: the policy is 5,131 chars and Telegram rejects
    anything over 4,096, so a single send failed outright and the user saw
    nothing at all. Every part stays persistent (it is the consent text, meant
    to be re-read minutes later) — ui.privacy_parts() keeps each one under the
    cap even after a later copy edit.
    """
    for part in PRIVACY_PARTS:
        await message.answer(part, parse_mode=ParseMode.HTML)


@router.message(Command("help"))
async def help_handler(message: Message):
    text = (
        "\U0001f4d6 <b>Help &amp; examples</b>\n"
        "<i>All commands below — <code>/start</code> for the overview, "
        "<code>/help</code> any time.</i>\n\n"
        "<b>ADD</b>\n"
        "<code>/track 9300111043900023959782</code>\n"
        "<code>/track 9300111043900023959782 Mom gift</code>\n"
        "<code>/track \"9400 1112 0620 0074 8883 50\" \"Mom's gift\"</code> (quotes work, alias: /add)\n"
        "<code>/track 9300… 9400… 1Z…</code> (several at once)\n"
        "📸 Send a label photo — the tracking number is decoded from its barcode "
        "and nothing else in the photo is read. I show you the number first, and "
        "only register it when you confirm.\n\n"
        "<b>VIEW</b>\n"
        "/list \u2013 all packages (alias: /packages)\n"
        "/info &lt;id or name&gt; \u2013 one package's card\n"
        "/status \u2013 bot health &amp; lookup stats\n\n"
        "<b>MANAGE</b>\n"
        "/name &lt;id&gt; New Name \u2013 rename (alias: /rename; or tap Rename and reply)\n"
        "/mute &lt;id&gt; \u2013 notifications on/off (alias: /unmute)\n"
        "/remove &lt;id&gt; \u2013 delete one (asks first)\n"
        "/forget \u2013 delete one without typing its number (asks first)\n"
        "/purge \u2013 delete delivered (asks first)\n"
        "/clear \u2013 delete all (admin only in groups)\n"
        "/cancel \u2013 drop a pending action\n\n"
        "<b>UPDATES</b>\n"
        "Automatic, paced by each package \u2014 there is no /update or /refresh.\n"
        f"In transit every {refresh.CADENCE['In Transit'][1] // 60} min (free) / "
        f"{refresh.CADENCE['In Transit'][0] // 60} min (Pro); delivered packages are never "
        "checked again. Manual refresh was removed by design: it let a busy chat "
        "burn the shared carrier quota, and checking on a package meant retyping "
        "its number into the chat.\n\n"
        "\U0001f4e6 <b>Porch Guard</b> \u2014 instant \u201cit's at your door\u201d "
        "ping on delivery, with a \u2705 ack; toggle per package on its card.\n\n"
        "<b>COLORS</b>\n"
        "\U0001f7e2 Delivered \u00b7 \U0001f7e3 Info Received \u00b7 \U0001f535 In Transit \u00b7 "
        "\U0001f7e0 Out for Delivery \u00b7 \U0001f7e1 Pickup \u00b7 \U0001f536 Attempted \u00b7 "
        "\U0001f534 Exception \u00b7 \u26aa Pending/Unavailable\n\n"
        "Carriers are auto-detected and links open the official carrier page. "
        "Some numbers show no status until the first scan — tracking starts by itself after that.\n\n"
        "\U0001f512 <b>Privacy:</b> what's collected, where it goes, how to delete it \u2014 "
        "<code>/privacy</code>"
    )
    if get_chat_id(message) in OWNER_CHAT_IDS:
        # Operator-only: this command is not in a user's menu and does nothing for
        # them, so it must not appear in the help they read either.
        text += (
            "\n\n<b>OPERATOR</b>\n"
            "/ping &lt;text&gt; \u2013 send it to every known chat now (no confirm)\n"
            "/ping \u2013 how many chats that would reach\n"
        )
    await message.answer(text, parse_mode=ParseMode.HTML)


@router.message(Command("track", "add"))
async def track_handler(message: Message):
    tracking_ids, custom_name = parse_track_args(message.text)
    if not tracking_ids:
        keep_input(message)     # nothing parsed — the user needs their own text back
        await send_ephemeral(message, 
            "Usage:\n<code>/track TRACKING_NUMBER [name]</code>\n"
            "Quotes work: <code>/track \"9400 1112 0620 0074 8883 50\" \"Mom's gift\"</code>\n"
            "Add several at once:\n<code>/track 9300… 9400… 1Z…</code>",
            parse_mode=ParseMode.HTML,
        )
        return

    await _add_packages(message, tracking_ids, custom_name)


async def _add_packages(message: Message, tracking_ids: List[str],
                        custom_name: str = None) -> None:
    """The add pipeline, shared by /track and the screenshot path.

    Limits, the per-chat lock, registration and the cards all live here, so the
    two entry points cannot drift apart. Every branch answers the user itself.

    custom_name applies to the first package only (a /track name argument). The
    screenshot path passes the name it read from the label's ship-to block
    (ui.extract_recipient_name), or None when the label printed no readable
    name — the package then falls back to the user's own default.
    """
    chat_id = get_chat_id(message)
    if chat_id not in track_sessions:
        track_sessions[chat_id] = {}

    # Two identical IDs in one command are ONE package: dedupe (order-preserving)
    # before the limit check, or a pasted duplicate would double-count against
    # the chat's quota. The custom name stays on the first survivor.
    tracking_ids = list(dict.fromkeys(tracking_ids))

    # The check → lookup → insert sequence must be atomic per chat: the lookup
    # awaits the network, and two adds for the same chat interleaved across it
    # both pass the limit check and both insert (over the cap, and burning a
    # duplicate 17TRACK registration). Same lock the Mini App add path takes.
    async with storage.get_chat_lock(chat_id):

        # Enforce package limit before doing any work
        new_ids = [t for t in tracking_ids if t not in track_sessions[chat_id]]
        can_add, limit_err = check_package_limit(chat_id, adding=len(new_ids))
        if not can_add:
            await send_ephemeral(message, 
                "⚠️ " + escape(limit_err) + "\n\n🌟 <b>Pro</b>: "
                f"{PRO_PACKAGE_LIMIT} packages · in-transit every "
                f"{refresh.CADENCE['In Transit'][0] // 60} min · delivery day "
                f"every {refresh.CADENCE['Out for Delivery'][0] // 60} min · themes\n"
                "Open the Mini App → Upgrade.",
                parse_mode=ParseMode.HTML,
            )
            return
        # International posts spend the bot's shared 17TRACK quota, so Pro covers a
        # fixed number of them (checked before the first lookup, from the format).
        can_add, intl_err = check_intl_limit(chat_id, new_ids)
        if not can_add:
            await send_ephemeral(message, "⚠️ " + escape(intl_err), parse_mode=ParseMode.HTML)
            return

        user_id = message.from_user.id if message.from_user else None
        multi = len(tracking_ids) > 1
        await send_ephemeral(message, "Looking up carrier and live status\u2026")

        skipped = []
        for idx, tracking_id in enumerate(tracking_ids):
            if tracking_id in track_sessions[chat_id]:
                skipped.append(tracking_id)
                continue

            info, reg_result = await _register_and_fetch(
                tracking_id, is_pro=pro.is_pro(chat_id), chat_id=chat_id)

            if custom_name and idx == 0:
                info["name"] = custom_name
            else:
                info["name"] = (f"{message.from_user.first_name}'s package" if message.from_user else "Package")
            info["added_by"] = user_id
            track_sessions[chat_id][tracking_id] = info
            save_data()

            text = package_card(tracking_id, info)
            prefix = "\u2705 Package added!\n\n"
            if reg_result == "skipped":
                prefix = (
                    "🌍 Package added — this carrier's tracking runs through 17TRACK, "
                    "which is a <b>Pro</b> feature. The package is saved and your last "
                    "known status is kept; it starts updating the moment you upgrade. "
                    "Tap Upgrade in the app.\n\n"
                )
            elif reg_result == "blocked":
                prefix = (
                    "\u23f3 Package added \u2014 17TRACK can't accept this number yet "
                    "(carrier first-scan policy). Tracking starts automatically after "
                    "the first acceptance scan \u2014 the app shows the same note.\n\n"
                )
            elif reg_result == "failed" and track17_api_key != "default_api_key":
                prefix += "\u26a0\ufe0f <i>Could not register with 17TRACK \u2014 check console/quota.</i>\n\n"

            # The tier surfaces quote the tally, not the stored count: the gate
            # spends slots on registrations, so "used" must be that number.
            if carriers.is_international_number(tracking_id):
                pro_chat = is_pro(chat_id)
                prefix += (
                    f"\n\ud83c\udf0d <i>International allowance: "
                    f"{count_international(chat_id)}/"
                    f"{PRO_INTL_LIMIT if pro_chat else FREE_INTL_LIMIT} used "
                    f"this {'period' if pro_chat else 'month'}.</i>")

            if multi:
                prefix = f"📦 {idx + 1} / {len(tracking_ids)}\n\n{prefix}"
            sent = await send_ephemeral(
                message,
                prefix + text,
                parse_mode=ParseMode.HTML,
                reply_markup=build_package_keyboard(tracking_id, info, is_pro(chat_id)),
                disable_web_page_preview=False,
            )
            info["card_msg_id"] = sent.message_id

        save_data()
    if skipped:
        # Same rule as /list: never re-print a tracking number into the chat.
        await send_ephemeral(
            message,
            (f"Already tracking {len(skipped)} of those — nothing added.\n"
             "<i>The app shows which ones.</i>"),
            parse_mode=ParseMode.HTML,
        )


# ──────────────────────────────────────────────
# Screenshot add path (OCR, local)
# ──────────────────────────────────────────────
# Free for everyone: this is an add-path convenience, not a Pro feature. The
# image is read on this machine with the system Tesseract binary (no Python OCR
# dependency), and it is deleted before the handler returns — the screenshot is
# a user's own document, and it must not outlive the request. Neither the image
# nor the recognised text is ever logged: only what was read out of it is
# kept — the numbers, and the recipient's name when the label prints one —
# exactly like a typed /track.
#
# One segmentation mode is not enough for the two shapes this path actually
# receives. --psm 6 ("a uniform block of text") suits a screenshot of a
# confirmation; a PHOTO of a shipping label has columns, boxes, a barcode and a
# logo, and psm 6 then garbles or interleaves the number line — the failure looks
# exactly like "no number in the picture". Sparse (11) and automatic (3) recover
# what 6 loses often enough to be worth a second and third read, and each mode's
# text is parsed on its own so fragments from two readings can never be butted
# together into a number that was never printed.
_OCR_PSMS = (6, 11, 3)
_OCR_TIMEOUT = 20        # the primary read: a screenshot needs well under a second
_OCR_EXTRA_TIMEOUT = 10  # the second opinions: bounded tighter on purpose


async def _ocr_file(path: str, psm: int = 6) -> str:
    """Tesseract over one image at one page-segmentation mode; '' on any failure.

    The timeout keeps one pathological image from pinning the handler, and it is
    shorter for the extra modes because only the primary read is what the user is
    waiting on.
    """
    timeout = _OCR_TIMEOUT if psm == _OCR_PSMS[0] else _OCR_EXTRA_TIMEOUT
    try:
        proc = await asyncio.create_subprocess_exec(
            "tesseract", path, "stdout", "-l", "eng", "--psm", str(psm),
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL,
        )
    except OSError as e:
        logger.warning("Screenshot OCR could not start tesseract: %s", e)
        return ""
    try:
        out, _ = await asyncio.wait_for(proc.communicate(), timeout=timeout)
    except asyncio.TimeoutError:
        proc.kill()
        await proc.wait()
        logger.warning("Screenshot OCR timed out after %ss (psm %s)", timeout, psm)
        return ""
    return out.decode("utf-8", "replace")


# ──────────────────────────────────────────────
# Barcode reads (the primary read — OCR is the fallback)
# ──────────────────────────────────────────────
# A printed number line is 40-odd small glyphs that Telegram's re-compression can
# smear: measured on a real label, tesseract read the number in 6/6 modes on the
# original file and in 0/60 reads on 1280-2560 px re-encodes, where "1Z 1E8" came
# back as "1Z 168". The barcode above that line carries the same number with a
# symbology check digit and survived every one of those re-encodes (3024 px down
# to 800 px, JPEG quality 30-95). So the barcode is read first, and when it yields
# a number Tesseract is not run at all: the number is exact AND the label's
# printed name and address are never turned into text in the first place.
_BARCODE_BIN = "zbarimg"
_BARCODE_TIMEOUT = 10    # one pass; zbar is well under a second on a phone photo

# BARCODE-ONLY is the shipping behaviour (the user's call, 2026-09-23): a photo is
# read from its barcodes and nothing else, so no label is ever OCR'd and no printed
# text is extracted. Setting this False restores the OCR fallback — the whole
# reversal. It is a flag rather than a deleted branch for two reasons: OCR is still
# the only reader that can add a text-only screenshot (an order confirmation has no
# barcode at all), and the retained `_ocr_file`/`_OCR_PSMS` code and its tests are
# kept honest by the `ocr_fallback` fixture in tests/test_photo_ocr.py flipping it.
_BARCODE_ONLY = True

# A parcel carries a second barcode besides the tracking one: the destination
# routing, "420" + ZIP(+4) — on the label this was built against, 420115504703.
# Twelve bare digits, so detect_carrier calls it fedex and the parser would take
# it, storing a FedEx-looking number for a UPS parcel. Refused by name, before the
# parser is consulted.
_ROUTING_BARCODE = re.compile(r"^420\d{5}(?:\d{4})?$")


def _barcode_supported() -> bool:
    """True when a barcode decoder is installed (zbar's own CLI)."""
    return shutil.which(_BARCODE_BIN) is not None


async def _decode_barcodes(path: str) -> List[str]:
    """Raw payloads of every barcode on the image; [] on any failure.

    zbar's CLI rather than the pyzbar binding, deliberately: `brew install zbar`
    ships this binary, while the binding has to locate libzbar through ctypes and
    on this Mac `ctypes.util.find_library("zbar")` returns None even with
    DYLD_FALLBACK_LIBRARY_PATH set — `import pyzbar.pyzbar` then raises
    ImportError. One subprocess also costs nothing next to the OCR reads that
    already run here, and it matches _ocr_file's shape exactly.

    --raw prints the payload alone, --quiet drops the progress chatter. A label's
    second barcode is its routing data ("420" + ZIP), so every payload still goes
    through the parser; nothing here decides what counts as a tracking number,
    and no payload is ever logged.
    """
    try:
        proc = await asyncio.create_subprocess_exec(
            _BARCODE_BIN, "--quiet", "--raw", path,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL,
        )
    except OSError as e:
        logger.warning("Barcode read could not start zbarimg: %s", e)
        return []
    try:
        out, _ = await asyncio.wait_for(proc.communicate(), timeout=_BARCODE_TIMEOUT)
    except asyncio.TimeoutError:
        proc.kill()
        await proc.wait()
        logger.warning("Barcode read timed out after %ss", _BARCODE_TIMEOUT)
        return []
    return [line.strip() for line in out.decode("utf-8", "replace").splitlines()
            if line.strip()]


async def _read_photo(message: Message) -> Tuple[List[str], List[str]]:
    """Download the largest photo once, read its barcode, then OCR if needed.

    Returns (numbers read from barcodes, one text per OCR mode). The deletion is
    in a finally so the image is gone on success AND on failure (download error,
    decode crash, timeout). The temp file lives in the private per-user temp dir
    rather than shared /tmp — same throwaway lifetime, less exposure for someone
    else's screenshot. One download for the whole read: the barcode pass and every
    OCR mode re-use the same file.

    OCR is skipped entirely once a barcode has produced a number: the barcode is
    exact, and skipping Tesseract means the label's printed name and address are
    never turned into text at all. A payload that does not parse as a tracking
    number is dropped here — never stored, logged or handed on.
    """
    tmp = tempfile.NamedTemporaryFile(prefix="packey_shot_", suffix=".jpg",
                                      delete=False)
    path = tmp.name
    tmp.close()
    try:
        await message.bot.download(message.photo[-1], destination=path)
        barcode_ids: List[str] = []
        for payload in await _decode_barcodes(path):
            if _ROUTING_BARCODE.fullmatch(payload):
                continue
            for tid in parse_track_args(payload, has_command=False)[0]:
                if tid not in barcode_ids:
                    barcode_ids.append(tid)
        if barcode_ids or _BARCODE_ONLY:
            # BARCODE-ONLY (see _BARCODE_ONLY): a photo without a barcode yields no
            # number — the sentence the user gets then says as much.
            return barcode_ids, []
        return barcode_ids, [await _ocr_file(path, psm) for psm in _OCR_PSMS]
    except Exception as e:
        # Type only: the exception can carry the file path, not the content.
        logger.warning("Screenshot read failed: %s", type(e).__name__)
        return [], []
    finally:
        try:
            os.remove(path)
        except OSError:
            pass


@router.message(F.photo)
async def photo_handler(message: Message):
    """Add packages from a photo of a shipping label.

    Caption first: a forwarded confirmation usually carries the number verbatim,
    which is both cheaper and more accurate than reading anything. Otherwise the
    image is decoded locally — its barcode only, never its printed text — and the
    number is shown back for confirmation before it costs a registration. Once
    confirmed, the numbers go through the same pipeline as /track: same limits,
    same lock, same cards, so an approved photo behaves like typing the number.
    """
    caption = (message.caption or "").strip()
    if caption:
        caption_ids, caption_name = parse_track_args(caption, has_command=False)
        if caption_ids:
            await _add_packages(message, caption_ids, caption_name or None)
            return

    # Photos are read from their barcodes, so zbar is the one reader that matters
    # (the OCR fallback is stashed — see _read_photo). Tesseract is deliberately
    # not mentioned: asking a user to install a tool this path never calls would
    # put a lie in the one message that exists to be true.
    if not _barcode_supported():
        # One-time setup, said once — never a crash or a retry loop.
        keep_input(message)     # the photo stays so it can be retried after setup
        await send_ephemeral(message, 
            "📸 I can't read photos on this machine yet — the barcode reader "
            "isn't installed.\nOne-time setup: <code>brew install zbar</code>",
            parse_mode=ParseMode.HTML,
        )
        return

    barcode_ids, texts = await _read_photo(message)
    # Every mode's text is parsed on its own, and the numbers are unioned: one
    # mode's garbled line is another mode's clean one, but joining two texts
    # would let a fragment of one meet a fragment of the other and spell a
    # number that was never printed. The text is noise as a name (it holds an
    # address), so only the ship-to block — extract_recipient_name — names the
    # package, and only from a mode that ALSO read a number: a reading too poor
    # to find the number is not trusted to name anyone. Barcode numbers lead and
    # are used exactly as decoded (no confusable repair — the symbology already
    # checked them). texts is always empty today: the OCR fallback is stashed, so
    # this loop and the name extraction in it are dormant alongside it, waiting for
    # the one-line reversal in _read_photo.
    tracking_ids: List[str] = list(barcode_ids)
    label_name = ""
    for text in texts:
        ids = parse_track_args(text, has_command=False)[0]
        if ids and not label_name:
            label_name = extract_recipient_name(text)
        for tid in ids:
            if tid not in tracking_ids:
                tracking_ids.append(tid)
    if not tracking_ids:
        keep_input(message)     # the photo stays so the user can retake or reframe it
        await send_ephemeral(message, 
            "Couldn't find a tracking number in that photo — the number has to be "
            "in one of the label's barcodes. Get the whole barcode in frame, or "
            "add it with <code>/track</code>.",
            parse_mode=ParseMode.HTML,
        )
        return
    # The number came out of a machine, so it is quoted back before anything is
    # spent: adding it here would burn quota (17TRACK registration / a paid Ship24
    # call / a browser fetch) on whatever the decoder produced, before any human
    # agreed it was the right number.
    await _ask_barcode_add(message, tracking_ids, label_name)


# A pending photo add waits for a tap, so whatever it needs to finish has to
# survive that wait: the confirmation store holds (user_id, ts) only, so the
# ship-to name — which only the stashed OCR fallback can read, the barcode path
# never has one — waits here, keyed exactly like its confirmation. Entries
# carry their own timestamp and are pruned on the same TTL, so a name read off
# a shipping label (user PII) never outlives its prompt (2026-10-04 audit).
_pending_photo_names: Dict[Tuple[int, str], Tuple[str, float]] = {}


def _prune_photo_names() -> None:
    """Drop photo names whose confirmation already expired. The confirmation
    store prunes lazily on access (storage.prune_confirmations); this rides
    the same rhythm instead of growing unbounded."""
    now = time.monotonic()
    for key, (_name, ts) in list(_pending_photo_names.items()):
        if now - ts > CONFIRM_TTL:
            del _pending_photo_names[key]


async def _ask_barcode_add(message: Message, tracking_ids: List[str],
                           label_name: str = "", source: str = "barcode") -> None:
    """Quote the number back and wait for a tap. Nothing is looked up here.

    Registering a number costs: a 17TRACK registration out of the bot's shared
    quota, sometimes a paid Ship24 call, otherwise a browser fetch. The number came
    out of a machine or was pasted, so showing it back before anything is spent is
    what makes a misread — or a typo — free, which is the whole reason this step
    exists. The prompt stays until it is tapped (as /privacy says); the card that
    follows is ephemeral. `source` only picks the heading: a photo's barcode, or the
    message the user typed.
    """
    chat_id = get_chat_id(message)
    user_id = message.from_user.id if message.from_user else 0
    heading = ("🔎 <b>Read from the barcode</b>" if source == "barcode"
               else "🔎 <b>From your message</b>")
    _prune_photo_names()
    for tracking_id in tracking_ids:
        store_confirmation((chat_id, "add", tracking_id), user_id)
        if label_name:
            _pending_photo_names[(chat_id, tracking_id)] = (label_name,
                                                            time.monotonic())
        carrier = carriers.detect_carrier(tracking_id)
        await message.answer(
            f"{heading}\n"
            f"<code>{escape(tracking_id)}</code> — {escape(carrier['name'])}\n\n"
            "Nothing has been looked up yet. Confirm and I'll register it and "
            "start tracking.",
            parse_mode=ParseMode.HTML,
            reply_markup=build_confirm_keyboard("add", tracking_id),
        )


async def _confirm_dead(callback: CallbackQuery, again: str) -> None:
    """A prompt whose confirmation is gone — cancelled, expired, pruned, or the bot
    restarted (the confirmation store is in memory) — is a dead button, not a way
    to run the action without a confirmation. Before this refused, /cancel left a
    working Confirm button behind: tapping it ran the action anyway."""
    await safe_edit_text(callback.message,
                         "\u23f3 That prompt is no longer active \u2014 " + again)
    await callback.answer("Prompt expired", show_alert=True)


@router.callback_query(F.data.startswith("confirm_add:"))
async def callback_confirm_add(callback: CallbackQuery):
    """The tap is the first thing that costs quota: before it, a photo only decoded."""
    tracking_id = callback.data.split(":", 1)[1]
    chat_id = callback.message.chat.id

    key = (chat_id, "add", tracking_id)
    requester_id = get_confirmation(key)
    if requester_id is None:
        await _confirm_dead(callback, "run /track again (or resend the photo).")
        return
    if callback.from_user.id != requester_id:
        await callback.answer("Only the person who sent the photo can confirm it.",
                              show_alert=True)
        return

    drop_confirmation(key)
    label_name = _pending_photo_names.pop((chat_id, tracking_id), ("", 0.0))[0]
    # The prompt carries the number; blank it out before the card lands.
    await safe_edit_text(callback.message, "✅ Confirmed — registering it now.")
    await callback.answer()
    await _add_packages(FakeMessage(callback), [tracking_id], label_name or None)


@router.message(Command("name", "rename"))
async def name_handler(message: Message):
    parts = message.text.split(maxsplit=2)
    if len(parts) < 3:
        keep_input(message)
        await send_ephemeral(message, 
            "Usage:\n<code>/name TRACKING_NUMBER New Name</code>", parse_mode=ParseMode.HTML
        )
        return
    tracking_id = _clean_tracking_id(parts[1])
    chat_id = get_chat_id(message)
    if chat_id not in track_sessions or tracking_id not in track_sessions[chat_id]:
        await send_ephemeral(message, f"\u274c Package <code>{escape(tracking_id)}</code> not found.", parse_mode=ParseMode.HTML)
        return
    if not await can_manage_package(message, tracking_id):
        await send_ephemeral(message, "\u274c Only admins or the person who added this package can rename it.")
        return
    new_name = parts[2].strip()[:64]
    track_sessions[chat_id][tracking_id]["name"] = new_name
    save_data()
    await send_ephemeral(message, f"\u270f\ufe0f Renamed to <b>{escape(new_name)}</b>", parse_mode=ParseMode.HTML)


@router.message(Command("list", "packages"))
async def list_handler(message: Message):
    """Compact roster: name, tracking number, status — nothing else.
    The Mini App is the dashboard; this is the quick glance."""
    chat_id = get_chat_id(message)
    packages = track_sessions.get(chat_id, {})
    if not packages:
        await send_ephemeral(message, 
            "\U0001f4e6 No packages yet \u2014 add one with <code>/track &lt;number&gt;</code>.",
            parse_mode=ParseMode.HTML,
        )
        return
    text = f"\U0001f4e6 <b>{len(packages)} package{'s' if len(packages) != 1 else ''}</b>\n"
    for idx, (tid, info) in enumerate(packages.items(), start=1):
        name = escape((info.get("name") or "").strip() or "Unnamed")
        status = escape(info.get("status") or "Pending")
        carrier = (info.get("carrier_name") or "").strip()
        # No tracking numbers here: /list lands in the same permanent chat
        # history the notifications avoid. Numbers live in the app (copy button)
        # and on a card, which is ephemeral.
        suffix = f" · {escape(carrier)}" if carrier else ""
        text += f"\n{idx}. <b>{name}</b> — {status}{suffix}\n"
    text = text.rstrip("\n")
    text += "\n\n\U0001f512 <i>Numbers and links stay in the app — nothing here.</i>"
    kwargs = {}
    if MINI_APP_URL and message.chat.type == ChatType.PRIVATE:
        kwargs["reply_markup"] = InlineKeyboardMarkup(inline_keyboard=[[
            InlineKeyboardButton(text="Open the app", web_app=WebAppInfo(url=MINI_APP_URL)),
        ]])
    await send_ephemeral(message, text, parse_mode=ParseMode.HTML, **kwargs)


def build_status_text() -> str:
    """The /status report, assembled here so tests can pin what it claims
    without faking Telegram messages. Read-only: it never mutates state and
    never spends a lookup (the quota reading is the hourly watch's cache)."""
    total_pkgs = sum(len(p) for p in track_sessions.values())
    chats = len(track_sessions)
    lines = ["\U0001f4ca <b>Bot status</b>\n"]
    lines.append(f"Uptime: {_format_duration(time.monotonic() - refresh.START_TS)}")
    lines.append(f"Packages tracked: {total_pkgs} (across {chats} chat{'s' if chats != 1 else ''})")
    lines.append(f"Last background cycle: {time_since(refresh.LAST_CYCLE_AT) if refresh.LAST_CYCLE_AT else 'never'}")

    # Health: when the next lookups happen, what the browser sweep last did.
    next_in = refresh.next_due_in()
    if next_in is not None:
        lines.append(f"Next lookups: in {_format_duration(next_in)} "
                     f"({refresh.pending_due()} due)")
    if refresh.LAST_SWEEP.get("at"):
        lines.append(
            f"Browser sweep: read {int(refresh.LAST_SWEEP['read'])}, "
            f"changed {int(refresh.LAST_SWEEP['changed'])} — "
            f"{_format_duration(max(0.0, time.time() - refresh.LAST_SWEEP['at']))} ago")

    # Lookups by tier: the gate keeps FREE off 17TRACK — this line makes that
    # auditable instead of a matter of trust (post-mortem 2026-09-18).
    lines.append("\n<b>Lookups (ok / fail):</b>")
    for src in sorted(set(LOOKUP_OK) | set(LOOKUP_FAIL)):
        ok, fail = LOOKUP_OK.get(src, 0), LOOKUP_FAIL.get(src, 0)
        if ok or fail:
            lines.append(f"\u2022 {escape(src)}: {ok} ok / {fail} fail")
    tier_bits = []
    for tier in ("pro", "free", "unknown"):
        t = carriers.LOOKUP_TIER[tier]
        if t["ok"] or t["fail"]:
            tier_bits.append(f"{tier}: {t['ok']} ok / {t['fail']} fail")
    if tier_bits:
        tier_line = " \u00b7 ".join(tier_bits)
        lines.append(f"\u2022 by tier — {escape(tier_line)}")

    # Quota + paid spend, from cached readings (never a live billed call).
    quota = carriers.quota_dict()
    if quota.get("known"):
        pct = quota["percent"] or 0.0
        pressure = ("critical" if pct >= carriers.TRACK17_HARD_PCT
                    else "high" if pct >= carriers.TRACK17_SOFT_PCT else "healthy")
        lines.append(f"17TRACK quota: {quota['used']}/{quota['total']} "
                     f"({pct}%) — {pressure}")
    lines.append(
        f"Ship24 today: {ship24.calls_today()}/{config.SHIP24_DAILY_MAX} paid calls"
        + (" — self-paused" if ship24.paused() else ""))

    # Package mix: the group words mirror the Mini App's summary line.
    mix = {"transit": 0, "delivered": 0, "attention": 0}
    needs_pro = muted = 0
    for packages in track_sessions.values():
        for info in packages.values():
            status = info.get("status", "Pending")
            if status == "Delivered":
                mix["delivered"] += 1
            elif status in ("Exception", "Delivery Attempted"):
                mix["attention"] += 1
            else:
                mix["transit"] += 1
            if info.get("needs_pro"):
                needs_pro += 1
            if info.get("muted"):
                muted += 1
    bits = [f"{mix['transit']} in transit", f"{mix['delivered']} delivered"]
    if mix["attention"]:
        bits.append(f"{mix['attention']} need attention")
    if needs_pro:
        bits.append(f"{needs_pro} paused (Pro)")
    if muted:
        bits.append(f"{muted} muted")
    lines.append("\n<b>Package mix:</b> " + escape(" \u00b7 ".join(bits)))

    carrier_hist: Dict[str, int] = {}
    for packages in track_sessions.values():
        for info in packages.values():
            name = info.get("carrier_name") or "Unknown"
            carrier_hist[name] = carrier_hist.get(name, 0) + 1
    if carrier_hist:
        lines.append("\n<b>Carriers:</b>")
        for name, count in sorted(carrier_hist.items(), key=lambda kv: kv[1], reverse=True):
            lines.append(f"\u2022 {escape(name)}: {count}")
    return "\n".join(lines)


@router.message(Command("status"))
async def status_handler(message: Message):
    chat_id = get_chat_id(message)
    if message.chat.type in (ChatType.GROUP, ChatType.SUPERGROUP) and not await is_admin(message):
        await send_ephemeral(message, "\u274c Only group admins can view /status.")
        return
    if chat_id not in OWNER_CHAT_IDS:
        # The full report is the operator's view: totals across every chat, the
        # carrier mix, the quota and the paid spend. A user gets their own slice —
        # enough to answer "is the bot working for me?", nothing about anyone else.
        mine = track_sessions.get(chat_id, {})
        muted = sum(1 for info in mine.values() if info.get("muted"))
        await send_ephemeral(
            message,
            f"\U0001f7e2 Operational \u00b7 {len(mine)} package(s) tracked for you"
            + (f" \u00b7 {muted} muted" if muted else ""),
            parse_mode=ParseMode.HTML)
        return
    await send_ephemeral(message, build_status_text(), parse_mode=ParseMode.HTML)


@router.message(Command("mute", "unmute"))
async def mute_handler(message: Message):
    args = message.text.split(maxsplit=1)
    if len(args) < 2:
        keep_input(message)
        await send_ephemeral(message, "Usage:\n<code>/mute TRACKING_NUMBER</code>", parse_mode=ParseMode.HTML)
        return
    tracking_id = _clean_tracking_id(args[1])
    chat_id = get_chat_id(message)

    if chat_id not in track_sessions or tracking_id not in track_sessions[chat_id]:
        await send_ephemeral(message, f"\u274c Package <code>{escape(tracking_id)}</code> not found.", parse_mode=ParseMode.HTML)
        return
    if not await can_manage_package(message, tracking_id):
        await send_ephemeral(message, "\u274c Only admins or the person who added this package can change its notifications.")
        return

    info = track_sessions[chat_id][tracking_id]
    info["muted"] = not info.get("muted")
    save_data()
    await send_ephemeral(message, 
        "\U0001f515 Notifications <b>muted</b> for this package." if info["muted"]
        else "\U0001f514 Notifications <b>enabled</b> for this package.",
        parse_mode=ParseMode.HTML,
    )


def _name_forms(info: dict) -> Tuple[str, ...]:
    """Every spelling of a package's name that the bot itself has printed for it.

    Two surfaces disagree about a blank name — the card prints its own "Package"
    placeholder, while /list and /forget print "Unnamed" — so a blank package
    answers to either, because the user can only type what they were shown. A name
    someone actually chose has exactly one spelling: its own.
    """
    name = str(info.get("name") or "").strip()
    return (name.casefold(),) if name else ("package", "unnamed")


class _PackageLookup(NamedTuple):
    """What an /info query found: one package, nothing, or a name shared by many.

    A tiny result object rather than an id-or-None because the third outcome is
    real: two packages can be named the same thing, and the answer to that is to
    ask, never to pick one.
    """

    tracking_id: Optional[str] = None
    matches: Tuple[Tuple[str, str], ...] = ()     # (tracking_id, name) pairs

    @property
    def status(self) -> str:
        if self.tracking_id:
            return "found"
        return "ambiguous" if self.matches else "missing"


def _resolve_package(chat_id: int, query: str) -> _PackageLookup:
    """Find a package by tracking number first, then by the name it is shown under.

    The number stays exactly as it was — it is what the Mini App, the callbacks and
    the other commands use. The name is the second chance, because retyping a
    number just to see a card is a copy-paste round trip, and /forget's own
    reasoning applies here too: typing a number into chat re-leaks it at the worst
    moment. Nothing about it is a guess — the name must match what the cards show.

    Matching is per chat and never crosses into another chat's packages, and a name
    matches every spelling the bot itself prints for that package (_name_forms), so
    whatever the user reads on screen is what they can type. A blank query resolves
    to nothing rather than to the first blank name.
    """
    packages = track_sessions.get(chat_id, {})

    cleaned = _clean_tracking_id(query)
    if cleaned in packages:
        return _PackageLookup(tracking_id=cleaned)

    wanted = query.strip().strip('"').strip("'").strip().casefold()
    if not wanted:
        return _PackageLookup()

    matches = tuple(
        (tid, str(info.get("name") or "").strip() or "Unnamed")
        for tid, info in packages.items()
        if wanted in _name_forms(info)
    )
    if len(matches) == 1:
        return _PackageLookup(tracking_id=matches[0][0])
    return _PackageLookup(matches=matches)


@router.message(Command("info"))
async def info_handler(message: Message):
    args = message.text.split(maxsplit=1)
    if len(args) < 2:
        keep_input(message)
        await send_ephemeral(message, 
            "Usage:\n<code>/info TRACKING_NUMBER_OR_NAME</code>", parse_mode=ParseMode.HTML
        )
        return
    chat_id = get_chat_id(message)
    lookup = _resolve_package(chat_id, args[1])

    if lookup.status == "missing":
        # Both routes, because a user who tried the number should learn the name
        # works, and the other way round.
        await send_ephemeral(message, 
            "\u274c No package with that tracking number or name.",
            parse_mode=ParseMode.HTML,
        )
        return

    if lookup.status == "ambiguous":
        # Never guess: the same name can cover two parcels, and a card for the
        # wrong one is worse than a question. The numbers ride an ephemeral message
        # like every other number-bearing reply.
        lines = ["\U0001f50d <b>Several packages share that name</b>", "",
                 "<i>Re-run /info with the tracking number to pick one.</i>"]
        for tid, name in lookup.matches:
            lines.append(f"\u2022 <b>{escape(name)}</b> \u2014 <code>{escape(tid)}</code>")
        await send_ephemeral(message, "\n".join(lines), parse_mode=ParseMode.HTML)
        return

    tracking_id = lookup.tracking_id
    info = track_sessions[chat_id][tracking_id]
    sent = await send_ephemeral(
        message,
        package_card(tracking_id, info),
        parse_mode=ParseMode.HTML,
        reply_markup=build_package_keyboard(tracking_id, info, is_pro(chat_id)),
        disable_web_page_preview=False,
    )
    info["card_msg_id"] = sent.message_id
    save_data()


@router.message(Command("forget"))
async def forget_handler(message: Message):
    """Privacy-first removal: pick a package from a list instead of typing its
    tracking number into the chat (typing it re-leaks it at the moment you're
    trying to delete it). The buttons carry the id in callback_data, which is
    never rendered in the chat — only the index is."""
    chat_id = get_chat_id(message)
    packages = track_sessions.get(chat_id, {})
    if not packages:
        await send_ephemeral(message, "\U0001f4e6 No packages yet — nothing to forget.")
        return

    ordered = sort_packages(packages)
    lines = ["\U0001f9f9 <b>Forget a package</b>", "",
             "<i>Pick one below — no tracking number needed.</i>"]
    rows = []
    for idx, (tid, info) in enumerate(ordered, start=1):
        name = (info.get("name") or "").strip() or "Unnamed"
        status = info.get("status") or "Pending"
        lines.append(f"{idx}. <b>{escape(name)}</b> — {escape(status)}")
        rows.append([InlineKeyboardButton(text=str(idx), callback_data=f"forget:{tid}")])
    if any(info.get("status") == "Delivered" for _, info in ordered):
        rows.append([InlineKeyboardButton(text="\U0001f9f9 Forget all delivered",
                                          callback_data="forget_all_delivered")])

    # Longer than a card's TTL: this list is something the user has to act on.
    await send_ephemeral(
        message, "\n".join(lines), ttl=max(config.EPHEMERAL_TTL, 300),
        parse_mode=ParseMode.HTML, reply_markup=InlineKeyboardMarkup(inline_keyboard=rows),
    )


@router.callback_query(F.data.startswith("forget:"))
async def callback_forget_pick(callback: CallbackQuery):
    """A picked index → the standard removal confirmation (same flow, same
    permissions, same /cancel support as /remove)."""
    tracking_id = callback.data.split(":", 1)[1]
    chat_id = callback.message.chat.id
    if tracking_id not in track_sessions.get(chat_id, {}):
        await callback.answer("Package not found", show_alert=True)
        return
    if not await can_manage_package(FakeMessage(callback), tracking_id):
        await callback.answer("No permission", show_alert=True)
        return

    name = track_sessions[chat_id][tracking_id]["name"]
    store_confirmation((chat_id, "remove", tracking_id), callback.from_user.id)
    await callback.answer()
    await safe_edit_text(
        callback.message,
        f"\U0001f5d1 Are you sure you want to forget <b>{escape(name)}</b>?",
        parse_mode=ParseMode.HTML,
        reply_markup=build_confirm_keyboard("remove", tracking_id),
    )


@router.callback_query(F.data == "forget_all_delivered")
async def callback_forget_all_delivered(callback: CallbackQuery):
    """Same confirmation the /purge command uses."""
    chat_id = callback.message.chat.id
    if callback.message.chat.type != ChatType.PRIVATE:
        if not await is_admin(FakeMessage(callback)):
            await callback.answer("\u274c Only group admins can forget delivered packages.",
                                  show_alert=True)
            return

    delivered = [tid for tid, info in track_sessions.get(chat_id, {}).items()
                 if info.get("status") == "Delivered"]
    if not delivered:
        await callback.answer("\U0001f7e2 Nothing delivered to forget", show_alert=True)
        return

    store_confirmation((chat_id, "purge", ""), callback.from_user.id)
    await callback.answer()
    await safe_edit_text(
        callback.message,
        f"\U0001f5d1 Are you sure you want to remove <b>{len(delivered)}</b> delivered package(s)?",
        parse_mode=ParseMode.HTML,
        reply_markup=build_confirm_keyboard("purge"),
    )


@router.message(Command("purge"))
async def purge_handler(message: Message):
