# ──────────────────────────────────────────────
# Startup
# ──────────────────────────────────────────────
async def check_17track_key() -> bool:
    """Verifies TRACK17_API_KEY against /getquota. Returns True if the key is
    valid or not set, False if set but invalid — the bot carries on without
    17TRACK rather than hard-failing. If the quota field names differ from
    what we expect, print the raw payload instead of '?' placeholders."""
    if track17_api_key == "default_api_key":
        return True

    try:
        resp = await http_client().post(
            f"{TRACK17_BASE_URL}/getquota",
            headers=_17track_headers(),
            json=[],
        )
        data = resp.json()
    except Exception as e:
        logger.warning("\u26a0\ufe0f Could not reach 17TRACK to verify TRACK17_API_KEY: %s", e)
        return False

    if data.get("code") == 0:
        q = data.get("data") or {}
        used, total, remain = q.get("quota_used"), q.get("quota_total"), q.get("quota_remain")
        if used is None or total is None:
            logger.info("\u2705 17TRACK key verified \u2014 quota data (raw): %s", q)
        else:
            logger.info("\u2705 17TRACK key verified \u2014 quota: %s/%s used, %s remaining.",
                        used, total, remain)
        return True

    logger.error("\u274c 17TRACK key check FAILED: %s", data)
    # The paid source going offline is invisible otherwise: lookups quietly fall
    # back to the slower tiers, so nobody notices until statuses get stale.
    await botstate.notify_admins(
        "⚠️ 17TRACK rejected our API key — the paid source is offline and lookups "
        "fall back to the slower tiers. See tracker.log.", key="17track-key")
    return False


async def main(token: str):
    global bot, _bot_token
    _bot_token = token
    # storage.py derives the encryption key from the token; keep its view
    # in sync with the rebind above (same value, assigned once, here).
    config._bot_token = token
    setup_logging()
    # ── Single-instance guard (cross-folder) ─────────────────────────────
    # A fixed lock path — NOT relative — so a second copy of this bot in any
    # directory (e.g. an old backup) can't poll the same token concurrently.
    lock_dir = Path.home() / "Library" / "Caches" / "packeybot"
    lock_dir.mkdir(parents=True, exist_ok=True)
    lock_fh = open(lock_dir / "instance.lock", "a")
    try:
        fcntl.flock(lock_fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        logger.error("❌ Another packeybot instance is already running "
                     "(lock: %s) — exiting so it isn't interfered with.",
                     lock_dir / "instance.lock")
        # This runs before the Bot exists, so the alert goes out over the token.
        await botstate.notify_admins(
            "⚠️ A second Packey instance started and exited — another instance "
            "already holds the lock, so this one did not run. See tracker.log.",
            key="instance")
        return
    lock_fh.write(str(os.getpid()))
    lock_fh.flush()
    load_data()
    load_cooldown()
    load_share_links()
    load_pro_state()
    # The receipt trail is the durable proof of payment: restore any Pro that a
    # crash between the two writes left out of pro_users (2026-10-04 audit).
    # Runs before the Bot exists, so the alert rides the pre-Bot path — whose
    # token-in-URL leak the redactor now covers.
    fixed = pro.reconcile_receipts()
    if fixed:
        await botstate.notify_admins(
            "PRO reconciled from the receipt trail for "
            f"{len(fixed)} chat(s) — details in tracker.log.")
    # Privacy: never leave a browser-cookie snapshot on disk between runs.
    # Cleanup also runs on shutdown; the startup pass covers ungraceful exits.
    try:
        import usps_browser
        usps_browser.cleanup_profile_copy()
    except Exception:
        pass

    dp = Dispatcher()
    import screens  # six review-able screens (screens.py); own router, own callbacks
    # screens.router goes FIRST: the main router ends in a catch-all
    # (unknown_handler) that would otherwise swallow /screens.
    dp.include_router(screens.router)
    dp.include_router(router)

    bot = Bot(token=token)
    # botstate owns the live handle read by pro/ui/refresh; refresh.save_now
    # was already wired to main's save_data wrapper at import time.
    botstate.set_bot(bot)
    logger.info("Bot started (%s)", MODEL_NAME)

    # A state file that could not be decrypted was preserved as .locked and its
    # store started empty. The loaders do that on purpose (better than refusing to
    # start), which makes this the only place the operator can hear about it.
    if storage.locked_preserved:
        await botstate.notify_admins(
            "⚠️ " + ", ".join(sorted(set(storage.locked_preserved))) +
            " could not be decrypted (wrong DATA_ENCRYPTION_KEY or bot token?) — "
            "preserved as .locked and skipped, so that state started empty. "
            "See tracker.log.", key="locked-state")

    # The backup watchdog (the backup script alerts on failure; this catches the
    # "job never ran" case — asleep through every scheduled window).
    await check_backup_staleness()

    # Tell the operator the bot is up, and what is new since the last start: new
    # code (fingerprint) and a new Mini App URL. Counts only — see
    # botstate.startup_note, which also debounces a crash loop.
    _note = botstate.startup_note(
        os.getpid(),
        {"chats": len(track_sessions),
         "packages": sum(len(pkgs) for pkgs in track_sessions.values()),
         "pro": sum(1 for expiry in _pro_users.values() if expiry > time.time())},
        (MINI_APP_URL or "").strip() or None)
    if _note:
        await botstate.notify_admins(_note, key="startup")

    # Mini App backend — always starts locally so a tunnel has a target.
    web_runner: Optional[web.AppRunner] = None
    try:
        web_runner = web.AppRunner(_build_miniapp_app())
        await web_runner.setup()
        await web.TCPSite(web_runner, MINI_APP_HOST, MINI_APP_PORT).start()
        where = f" (public: {MINI_APP_URL})" if MINI_APP_URL else \
            " (local only — set MINI_APP_URL to your public HTTPS URL to expose it)"
        logger.info("\U0001f5a5\ufe0f Mini App backend on http://%s:%d%s",
                    MINI_APP_HOST, MINI_APP_PORT, where)
    except OSError as e:
        logger.warning("\u26a0\ufe0f Mini App backend not started: %s", e)
        web_runner = None

    # Populate the Telegram "☰ commands" menu (shown on the text-input bar).
    menu_commands = [BotCommand(command=name, description=desc)
                     for name, desc in MENU_ITEMS]
    try:
        await bot.set_my_commands(menu_commands)
    except Exception as e:
        logger.warning("Could not set the commands menu: %s", e)

    # The operator's menu: /ping ON TOP of the full list — a chat-scoped menu
    # REPLACES the default one (Telegram picks the most specific scope and never
    # merges), so the registration must carry the whole list.
    for _owner in sorted(OWNER_CHAT_IDS):
        try:
            await bot.set_my_commands(
                [BotCommand(command="ping", description="Broadcast to every chat")]
                + menu_commands,
                scope=BotCommandScopeChat(chat_id=_owner))
        except Exception as e:
            logger.warning("Could not set the operator commands menu: %s", e)

    if not config.WEBHOOK_TOKEN:
        await botstate.notify_admins(
            "⚠️ The 17TRACK webhook is DISABLED (no WEBHOOK_TOKEN set) — push "
            "events are off and tracking runs on the poller alone. Set it in "
            ".env and update the URL in 17TRACK's console to re-enable pushes.",
            key="webhook")

    # The persistent "📦 Packages" menu button was removed as redundant —
    # /start and /list already carry the "Open the app" button. Actively
    # reset to the default button in case the old one is still set.
    try:
        await bot.set_chat_menu_button(menu_button=MenuButtonDefault())
    except Exception as e:
        logger.warning("Could not reset the menu button: %s", e)

    # The Mini App button bakes MINI_APP_URL into each message at send time —
    # if the tunnel URL changed since last run, ship one fresh button to
    # every chat with packages so stale buttons self-heal (no-op otherwise).
    _announce = maybe_announce_miniapp_url(bot)
    if _announce is not None:
        try:
            await _announce
        except Exception as e:
            logger.warning("Mini App URL announcement failed: %s", e)

    track17_ok = await check_17track_key()
    sources = []
    if track17_api_key != 'default_api_key' and track17_ok:
        # Register only what 17TRACK will actually serve: a free chat's numbers
        # can't use it (Pro perk), and a number routed to an official API doesn't
        # need it — either way a slot spent there is a slot wasted.
        await re_register_all_17track(
            eligible=lambda cid, tid: carriers._use_17track(
                carriers.detect_carrier(tid)["code"], pro.is_pro(cid)))
        sources.append("17TRACK")
    if usps_api.enabled():
        sources.append("USPS API v3 (official)")
    if USPS_API_USERID:
        sources.append("USPS Web Tools (USPS packages)")
    if USPS_BROWSER_TRACK:
        try:
            import usps_browser
            tiers = ", ".join(
                f"{usps_browser.page_label(slug)}"
                for slug in usps_browser.browser_slugs())
            sources.append(f"carrier-site browser ({tiers})")
        except ImportError:
            sources.append("USPS browser (experimental)")
    if ship24.enabled():
        # Listed last on purpose: it is the paid last resort, not a first choice.
        sources.append("Ship24 (paid fallback)")
    if sources:
        logger.info("\U0001f4e1 Status sources active: %s (plus direct scraping for non-blocked carriers).",
                    ", ".join(sources))
    else:
        logger.info("\U0001f4e1 No TRACK17_API_KEY set \u2014 most "
                    "carriers will show 'Unavailable'. Set TRACK17_API_KEY for "
                    "full coverage.")

    _updater_task = asyncio.create_task(background_updater())  # keep a reference
    _sol_task = asyncio.create_task(monitor_solana_payments())  # keep a reference
    _expiry_task = asyncio.create_task(_pro_expiry_task())      # keep a reference
    try:
        await dp.start_polling(bot)
    finally:
        _updater_task.cancel()
        # These two are long-lived too: cancel them so shutdown is complete
        # instead of leaving them to be torn down with the loop.
        _sol_task.cancel()
        _expiry_task.cancel()
        save_data()
        save_cooldown()
        try:
            import usps_browser
            usps_browser.cleanup_profile_copy()  # privacy: drop the cookie snapshot
        except Exception:
            pass
        if carriers._http is not None and not carriers._http.is_closed:
            await carriers._http.aclose()
        await bot.session.close()
        if web_runner is not None:
            await web_runner.cleanup()


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Telegram Package Tracker Bot")
    parser.add_argument(
        "token", nargs="?", default=os.getenv("TELEGRAM_BOT_API_TOKEN"),
        help="Telegram bot token (or set TELEGRAM_BOT_API_TOKEN env var)",
    )
    parser.add_argument(
        "--track17-key", dest="track17_key", default=None,
        help="17TRACK API key (or set TRACK17_API_KEY env var)",
    )
    args = parser.parse_args()

    if not args.token:
        print("Error: Bot token required")
        print("Usage: python3 main.py <BOT_TOKEN> [--track17-key KEY]")
        sys.exit(1)

    # CLI flags take priority over the env vars read at module load time.
    if args.track17_key:
        track17_api_key = args.track17_key
        # config.py holds the copy the backends read at call time
        # (carriers._17track_headers / register_17track / _check_17track), so the
        # override has to land there. The old carriers.track17_api_key assignment
        # was dead: nothing ever read that attribute.
        config.track17_api_key = args.track17_key

    asyncio.run(main(args.token))