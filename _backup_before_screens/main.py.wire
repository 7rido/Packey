# ──────────────────────────────────────────────
# Logging — console + rotating file
# ──────────────────────────────────────────────
LOG_FILE = Path("tracker.log")

_SECRET_RE = re.compile(
    r"(?<![A-Za-z0-9_-])"
    r"((?:api[-_]?key|apikey|access[-_]?token|token|key|secret|password)=)"
    r"[^&\s\"']+", re.IGNORECASE)
# Capability URLs: /share/<token> and /pay/<invoice-id> hand over their page to
# whoever holds the path. They must travel in a USER's chat — that is how the link
# reaches them — but never in tracker.log, where aiohttp's access log writes every
# request path through the root logger (measured: aiohttp.access lines are in
# tracker.log). Without this, the first share-link click would write the bearer
# token to disk.
_PATH_SECRET_RE = re.compile(r"(/(?:share|pay|webhook/17track)/)([A-Za-z0-9_-]{4,})")
# The pre-Bot operator-alert path (botstate.notify_admins before set_bot() exists)
# posts to https://api.telegram.org/bot<TOKEN>/sendMessage with plain httpx, and
# httpx logs every request line at INFO — the same path-embedded-secret leak the
# capability URLs above guard against, except this one is the bot's master
# credential (audit 2026-10-04).
_BOT_TOKEN_RE = re.compile(r"/bot(\d+:[A-Za-z0-9_-]{20,})")


def _redact_text(text: str) -> str:
    text = _SECRET_RE.sub(r"\1<redacted>", text)
    text = _PATH_SECRET_RE.sub(r"\1<redacted>", text)
    return _BOT_TOKEN_RE.sub(r"/bot<redacted>", text)


class _SecretRedactor(logging.Filter):
    """Scrub URL-embedded secrets from every record before it reaches disk.

    httpx logs full request URLs at INFO, and providers like Helius carry the
    API key as a query parameter — without this filter, every 10-second RPC
    poll wrote the key into tracker.log (585 lines in the first hours).
    Redacting here keeps the useful request log while making sure a secret can
    never reach the disk, whatever future provider embeds one: the parameter
    name is the defence, so every spelling a provider might use is matched, not
    just the api-key= that was measured.
    """

    def filter(self, record):
        try:
            msg = record.getMessage()
        except Exception:
            return True
        red = _redact_text(msg)
        if red != msg:
            record.msg = red
            record.args = None
        return True


class _RedactingFormatter(logging.Formatter):
    """Redact the final rendered text — tracebacks included.

    A Filter runs before Handler.emit renders exc_info, so a secret inside an
    exception's own text (an httpx error quoting the request URL) sailed past the
    filter into tracker.log. Redacting in the formatter closes that: by then the
    message and the traceback are both final text.
    """

    def format(self, record):
        return _redact_text(super().format(record))

    def formatException(self, ei):
        return _redact_text(super().formatException(ei))


def _chmod_logs_0600() -> None:
    """Privacy: the log masks chat IDs and tracking numbers — keep it
    owner-only, including every rotation-shifted copy."""
    for _p in (LOG_FILE, f"{LOG_FILE}.1", f"{LOG_FILE}.2", f"{LOG_FILE}.3"):
        try:
            os.chmod(_p, 0o600)
        except OSError:
            pass


class _OwnerOnlyRotatingHandler(logging.handlers.RotatingFileHandler):
    """Rollover recreates the log file with the process umask (0644 here), and
    the startup chmod never runs again — within a day of rotation all four
    tracker.log* were world-readable (2026-10-04 audit). Re-assert owner-only
    after every rollover."""

    def doRollover(self):
        super().doRollover()
        _chmod_logs_0600()


def setup_logging():
    """Idempotent console + rotating-file logging setup."""
    root = logging.getLogger()
    if root.handlers:
        return
    fmt = _RedactingFormatter("%(asctime)s %(levelname)-7s %(name)s: %(message)s", "%Y-%m-%d %H:%M:%S")
    sh = logging.StreamHandler()
    sh.setFormatter(fmt)
    sh.addFilter(_SecretRedactor())
    root.addHandler(sh)
    try:
        fh = _OwnerOnlyRotatingHandler(
            LOG_FILE, maxBytes=1_000_000, backupCount=3, encoding="utf-8"
        )
        fh.setFormatter(fmt)
        fh.addFilter(_SecretRedactor())
        root.addHandler(fh)
        _chmod_logs_0600()
    except OSError as e:
        root.warning("Could not create log file %s: %s", LOG_FILE, e)
    root.setLevel(logging.INFO)


