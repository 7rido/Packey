    )


@router.message()
async def unknown_handler(message: Message):
    """Friendly fallback for anything that isn't one of the bot's commands.

    It finishes a rename too: after Rename, the next ordinary message IS the new
    name — that is what the button promises, and a bare name is not a command, so
    this is the only place it can arrive.
    """
    if not message.text:
        return
    text = message.text.strip()
    first = text.split()[0] if text.split() else ""
    if first.startswith("/") and "@" in first:
        # /cmd@otherbot is addressed to another bot — answering it would talk over
        # a conversation that is not ours. get_me is cached: one call per process.
        target = first.split("@", 1)[1].lower()
        ours = await _bot_username()
        if ours and target != ours:
            return
    chat_id = get_chat_id(message)
    user_id = message.from_user.id if message.from_user else 0
    if not text.startswith("/"):
        tracking_id = _take_pending_rename(chat_id, user_id)
        if tracking_id and tracking_id in track_sessions.get(chat_id, {}):
            new_name = message.text.strip()[:64]
            track_sessions[chat_id][tracking_id]["name"] = new_name
            save_data()
            await send_ephemeral(
                message,
                f"\u270f\ufe0f Renamed to <b>{escape(new_name)}</b>",
                parse_mode=ParseMode.HTML,
            )
            return
        # "Send a tracking number — that's it." (/start) was not implemented until
        # 2026-09-26: a pasted number fell through to "I don't understand", and the
        # tidy middleware deleted the user's message with it. It now goes through the
        # SAME confirm-then-register prompt as a barcode read, because that step is
        # what makes a typo free — registering spends a 17TRACK slot (sometimes a
        # paid lookup). Caps and the per-chat lock are enforced inside _add_packages,
        # so this path cannot bypass them. A rename answer wins above on purpose: the
        # prompt asked for a name, so a number-looking reply IS the name.
        import screens  # screen 4's "Custom name" answer (inert unless one is pending)
        if await screens.apply_custom_name(message):
            return
        ids = parse_track_args(message.text, has_command=False)[0]
        if ids:
            await _ask_barcode_add(message, ids, source="message")
            return
    # Nothing was acted on: the message stays so the user can see what they sent.
    keep_input(message)
    await send_ephemeral(message,
        "\U0001f9e0 I don't understand that \u2014 I'm just a package tracker.\n"
        "Use <code>/help</code> to see my commands.",
        parse_mode=ParseMode.HTML,
    )


_bot_username_cache: Optional[str] = None


async def _bot_username() -> Optional[str]:
    """Our own @handle, fetched once. Telegram routes a group's /cmd@otherbot to
    every bot that can see it, so the mention is the only way to know a command is
    not ours — and replying to it would talk over someone else's bot."""
    global _bot_username_cache
    if _bot_username_cache is None and botstate.bot is not None:
        try:
            me = await botstate.bot.get_me()
            _bot_username_cache = (me.username or "").lower()
        except Exception as e:
            logger.debug("get_me failed: %s", type(e).__name__)
    return _bot_username_cache


@router.callback_query(F.data.startswith("mute:"))
async def callback_mute(callback: CallbackQuery):
    tracking_id = callback.data.split(":", 1)[1]
    chat_id = callback.message.chat.id

    if tracking_id not in track_sessions.get(chat_id, {}):
        await callback.answer("Package not found", show_alert=True)
        return
    if not await can_manage_package(FakeMessage(callback), tracking_id):
        await callback.answer("No permission", show_alert=True)
        return

    info = track_sessions[chat_id][tracking_id]
    info["muted"] = not info.get("muted")
    save_data()
    await safe_edit_text(
        callback.message,
        package_card(tracking_id, info),
        parse_mode=ParseMode.HTML,
        reply_markup=build_package_keyboard(tracking_id, info, is_pro(chat_id)),
    )
    await callback.answer("Notifications muted" if info["muted"] else "Notifications on")


@router.callback_query(F.data.startswith("pg:"))
async def callback_porch_guard(callback: CallbackQuery):
    """Flip Porch Guard for one package.

    Not Pro-gated (unlike the direction toggle): a free chat gets the ping on the
    slow cadence and a Pro chat gets it webhook-fast, and that difference is the
    upsell rather than a locked switch. Needs can_manage_package, like mute.
    """
    tracking_id = callback.data.split(":", 1)[1]
    chat_id = callback.message.chat.id

    if tracking_id not in track_sessions.get(chat_id, {}):
        await callback.answer("Package not found", show_alert=True)
        return
    if not await can_manage_package(FakeMessage(callback), tracking_id):
        await callback.answer("No permission", show_alert=True)
        return

    info = track_sessions[chat_id][tracking_id]
    info["porch_guard"] = not info.get("porch_guard", True)
    save_data()
    await safe_edit_text(
        callback.message,
        package_card(tracking_id, info),
        parse_mode=ParseMode.HTML,
        reply_markup=build_package_keyboard(tracking_id, info, is_pro(chat_id)),
    )
    await callback.answer(
        "🔔 Porch guard on — I'll shout the moment it's delivered"
        if info["porch_guard"] else "🔕 Porch guard off")


@router.callback_query(F.data.startswith("pg_ack:"))
async def callback_porch_ack(callback: CallbackQuery):
    """The delivery ping's ✅ Got it.

    Deliberately no permission check: whoever taps it is standing at the door with
    the parcel, and "it's inside" changes nothing but a notification flag. The
    only guard is that the package must still exist.
    """
    tracking_id = callback.data.split(":", 1)[1]
    chat_id = callback.message.chat.id
    info = track_sessions.get(chat_id, {}).get(tracking_id)
    if info is None:
        await callback.answer("Package not found", show_alert=True)
        return

    info["porch_acked"] = True
    save_data()
    await safe_edit_text(
        callback.message,
        refresh.PORCH_ACKED.format(name=escape(info.get("name", "Package"))),
        parse_mode=ParseMode.HTML,
    )
    await callback.answer("Nice — marked safe.")


@router.callback_query(F.data.startswith("direction:"))
async def callback_direction(callback: CallbackQuery):
    """Flip a package between incoming and outgoing.

    Display-only metadata, and Pro-gated: a free chat never sees the button
    (and this refuses anyway). An existing "outgoing" is grandfathered — a
    downgraded member keeps reading it, they just cannot set it.
    """
    tracking_id = callback.data.split(":", 1)[1]
    chat_id = callback.message.chat.id

    if tracking_id not in track_sessions.get(chat_id, {}):
        await callback.answer("Package not found", show_alert=True)
        return
    if not is_pro(chat_id):
        await callback.answer("Outgoing is a Pro feature", show_alert=True)
        return
    if not await can_manage_package(FakeMessage(callback), tracking_id):
        await callback.answer("No permission", show_alert=True)
        return

    info = track_sessions[chat_id][tracking_id]
    info["direction"] = ("incoming" if info.get("direction") == "outgoing"
                         else "outgoing")
    save_data()
    await safe_edit_text(
        callback.message,
        package_card(tracking_id, info),
        parse_mode=ParseMode.HTML,
        reply_markup=build_package_keyboard(tracking_id, info, is_pro(chat_id)),
    )
    await callback.answer("\U0001f4e5 Marked incoming"
                          if info["direction"] == "incoming" else "\U0001f4e4 Marked outgoing")


@router.callback_query(F.data.startswith("share:"))
async def callback_share(callback: CallbackQuery):
    """Mint a public status link for one package.

    The link is a bearer token, so the reply that carries it is ephemeral: chat
    history — a group's especially — is permanent, and a leaked URL keeps
    working. The button on that reply is the only way to revoke.
    """
    tracking_id = callback.data.split(":", 1)[1]
    chat_id = callback.message.chat.id

    if tracking_id not in track_sessions.get(chat_id, {}):
        await callback.answer("Package not found", show_alert=True)
        return
    if not await can_manage_package(FakeMessage(callback), tracking_id):
        await callback.answer("No permission", show_alert=True)
        return
    if not MINI_APP_URL:
        # No public URL configured: say so instead of minting a dead link.
        await callback.answer("Public links aren't available right now",
                              show_alert=True)
        return

    token = share_links.mint(chat_id, tracking_id)
    url = f"{MINI_APP_URL.rstrip('/')}/share/{token}"
    lifetime = (f"expires in {SHARE_LINK_TTL_DAYS} days"
                if SHARE_LINK_TTL_DAYS > 0 else "does not expire")
    await send_ephemeral(
        callback.message,
        f"\U0001f517 <b>Share link</b> ({lifetime}):\n{escape(url)}\n\n"
        "Anyone with this link can see the package's status — never its "
        "tracking number. This message deletes itself; the link keeps working, "
        "and pressing Share again replaces it.",
        parse_mode=ParseMode.HTML,
        reply_markup=InlineKeyboardMarkup(inline_keyboard=[[
            InlineKeyboardButton(text="\U0001f6ab Revoke link",
                                 callback_data=f"share_revoke:{token}"),
        ]]),
        disable_web_page_preview=True,
    )
    await callback.answer("Link created")


@router.callback_query(F.data.startswith("share_revoke:"))
async def callback_share_revoke(callback: CallbackQuery):
    """Kill a share link.

    Guarded like minting: in a group, a member who can see the link message
    must not be able to revoke someone else's link (the message is ephemeral,
    so this window is short — the guard still belongs here).
    """
    token = callback.data.split(":", 1)[1]
    record = share_links.lookup(token)
    if record is None:
        await callback.answer("That link is already gone", show_alert=True)
        return
    if not await can_manage_package(FakeMessage(callback),
                                    record.get("tracking_id", "")):
        await callback.answer("No permission", show_alert=True)
        return

    share_links.revoke(token)
    await send_ephemeral(
        callback.message,
        "\U0001f6ab <b>Link revoked.</b> Anyone who had that URL can no longer "
        "open the page. Press Share again for a new link.",
        parse_mode=ParseMode.HTML,
    )
    await callback.answer("Link revoked")


@router.callback_query(F.data.startswith("remove:"))
async def callback_remove_ask(callback: CallbackQuery):
    tracking_id = callback.data.split(":", 1)[1]
    chat_id = callback.message.chat.id

    # Guard: package may have been removed since this button was rendered.
    if tracking_id not in track_sessions.get(chat_id, {}):
        await callback.answer("Package not found", show_alert=True)
        return

    if not await can_manage_package(FakeMessage(callback), tracking_id):
        await callback.answer("No permission", show_alert=True)
        return

    name = track_sessions[chat_id][tracking_id]["name"]
    store_confirmation((chat_id, "remove", tracking_id), callback.from_user.id)
    await safe_edit_text(
        callback.message,
        f"Are you sure you want to remove <b>{escape(name)}</b>?",
        parse_mode=ParseMode.HTML,
        reply_markup=build_confirm_keyboard("remove", tracking_id),
    )
    await callback.answer()


@router.callback_query(F.data.startswith("confirm_remove:"))
async def callback_confirm_remove(callback: CallbackQuery):
    tracking_id = callback.data.split(":", 1)[1]
    chat_id = callback.message.chat.id

    key = (chat_id, "remove", tracking_id)
    requester_id = get_confirmation(key)
    if requester_id is None:
        await _confirm_dead(callback, "run /remove again if you still want that.")
        return
    if callback.from_user.id != requester_id:
        await callback.answer("Only the person who requested this can confirm it.", show_alert=True)
        return
    if not await can_manage_package(FakeMessage(callback), tracking_id):
        await callback.answer("No permission", show_alert=True)
        return

    drop_confirmation(key)

    if tracking_id in track_sessions.get(chat_id, {}):
        name = track_sessions[chat_id][tracking_id]["name"]
        del track_sessions[chat_id][tracking_id]
        save_data()
        await carriers.stop_17track_if_unshared([tracking_id], chat_id)
        await safe_edit_text(callback.message, f"\U0001f5d1 Removed <b>{escape(name)}</b>", parse_mode=ParseMode.HTML)
    else:
        await safe_edit_text(callback.message, "Package already removed.")
    await callback.answer()


@router.callback_query(F.data == "confirm_purge")
async def callback_confirm_purge(callback: CallbackQuery):
    chat_id = callback.message.chat.id

    key = (chat_id, "purge", "")
    requester_id = get_confirmation(key)
    if requester_id is None:
        await _confirm_dead(callback, "run /purge again if you still want that.")
        return
    if callback.from_user.id != requester_id:
        await callback.answer("Only the person who requested this can confirm it.", show_alert=True)
        return
    if callback.message.chat.type != ChatType.PRIVATE:
        if not await is_admin(FakeMessage(callback)):
            await callback.answer("\u274c Only group admins can purge delivered packages.", show_alert=True)
            return

    drop_confirmation(key)

    removed = [tid for tid, info in track_sessions.get(chat_id, {}).items()
               if info.get("status") == "Delivered"]
    for tid in removed:
        del track_sessions[chat_id][tid]
    save_data()
    await carriers.stop_17track_if_unshared(removed, chat_id)
    await safe_edit_text(
        callback.message,
        f"\U0001f5d1 Removed <b>{len(removed)}</b> delivered package(s).",
        parse_mode=ParseMode.HTML,
    )
    await callback.answer()


@router.callback_query(F.data == "confirm_clear")
async def callback_confirm_clear(callback: CallbackQuery):
    chat_id = callback.message.chat.id

    key = (chat_id, "clear", "")
    requester_id = get_confirmation(key)
    if requester_id is None:
        await _confirm_dead(callback, "run /clear again if you still want that.")
        return
    if callback.from_user.id != requester_id:
        await callback.answer("Only the person who requested this can confirm it.", show_alert=True)
        return
    if callback.message.chat.type != ChatType.PRIVATE:
        if not await is_admin(FakeMessage(callback)):
            await callback.answer("\u274c Only group admins can clear all packages.", show_alert=True)
            return

    drop_confirmation(key)

    if chat_id in track_sessions:
        count = len(track_sessions[chat_id])
        to_stop = list(track_sessions[chat_id])
        track_sessions[chat_id].clear()
        save_data()
        await carriers.stop_17track_if_unshared(to_stop, chat_id)
        await safe_edit_text(callback.message, f"\U0001f5d1 Cleared <b>{count}</b> package(s).", parse_mode=ParseMode.HTML)
    else:
        await safe_edit_text(callback.message, "Nothing to clear.")
    await callback.answer()


@router.callback_query(F.data == "cancel_action")
async def callback_cancel(callback: CallbackQuery):
    await safe_edit_text(callback.message, "\u274c Action cancelled.")
    await callback.answer()


# The rename hand-off. "Reply with the new name" has to know WHICH package the
# answer is for, and the prompt must NOT carry the tracking number: this bot keeps
# numbers out of permanent history (cards are ephemeral, /list omits them) and this
# prompt stays until it is answered. So the target waits here, keyed by chat, bound
# to the user who tapped — the confirmation handlers' requester rule — and with a
# deadline, so a stale prompt cannot capture an unrelated later message.
# In memory on purpose: this is UI state, not data. A restart costs one re-tap.
_RENAME_TTL_SECONDS = 600
_pending_renames: Dict[int, Tuple[str, int, float]] = {}


def _take_pending_rename(chat_id: int, user_id: int) -> Optional[str]:
    """The live rename target for this chat+user, consumed; None if none or expired.

    Consuming on lookup is the point: one message is one attempt, so a leftover
    target cannot rename with whatever arrives after it. Another user's message does
    NOT consume it — in a group they would otherwise spend a rename they never asked
    for.
    """
    entry = _pending_renames.get(chat_id)
    if entry is None or entry[1] != user_id:
        return None
    tracking_id, _requester, deadline = entry
    _pending_renames.pop(chat_id, None)
    return tracking_id if deadline > time.monotonic() else None


@router.callback_query(F.data.startswith("rename:"))
async def callback_rename(callback: CallbackQuery):
    """Ask for the new name and remember which package the answer belongs to.

    What this replaced (reported 2026-09-26): the button replied with a
    "<code>/name &lt;id&gt; New Name Here</code>" block to copy, edit and send. It
    looked like something had been renamed — while a tap on that block only COPIES
    it, and a user who sent it verbatim named their package the literal words
    "New Name Here". ForceReply makes it one typed answer, applied by
    unknown_handler (a bare name is not a command, so that is the only handler it
    can reach).
    """
    tracking_id = callback.data.split(":", 1)[1]
    chat_id = callback.message.chat.id
    if not await can_manage_package(FakeMessage(callback), tracking_id):
        await callback.answer("No permission", show_alert=True)
        return
    info = track_sessions.get(chat_id, {}).get(tracking_id) or {}
    label = (info.get("name") or "").strip() or "this package"
    _pending_renames[chat_id] = (
        tracking_id,
        callback.from_user.id if callback.from_user else 0,
        time.monotonic() + _RENAME_TTL_SECONDS,
    )
    await callback.message.answer(
        f"\u270f\ufe0f Rename <b>{escape(label)}</b>\nReply with the new name.",
        parse_mode=ParseMode.HTML,
        reply_markup=ForceReply(selective=True),
    )
    await callback.answer()


