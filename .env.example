# Copy to .env and fill in your values:
#   cp .env.example .env
TELEGRAM_BOT_API_TOKEN=123456:ABCdef...
TRACK17_API_KEY=
USPS_API_USERID=
USPS_API_PASSWORD=
# Seconds before the bot deletes its own data-bearing messages (package cards,
# /list, /info). Keeps tracking numbers out of chat history. 0 = keep forever.
EPHEMERAL_TTL=90
# Porch Guard: seconds to wait for the ✅ ack after a delivery ping before asking
# once more. One re-ping only, then silence. 0 = never re-ping.
PORCH_REPING_SECONDS=900
# Days before a DELIVERED package is forgotten entirely (number and all).
# 0 keeps delivered packages forever.
RETENTION_DAYS=14
# How many delivery-history records to keep (carrier, transit days, when it
# landed — no chat ID and no tracking number in any of them). A COUNT, not a
# days-based cut: the file is rewritten in full on every delivery, so this
# bounds that cost. 0 keeps every record forever.
DELIVERY_HISTORY_MAX=1000
# Days with NO carrier event (new status or new detail text) before a package
# that is still moving is declared lost: one ephemeral funeral notice, a
# memorial line on its card, and a resurrection notice if scans resume.
# 0 disables it.
LOST_AFTER_DAYS=30
# Days a shared tracking link keeps working. A link is an unguessable public
# URL (anyone holding it can see that package's name, status and latest update
# — never the tracking number). 0 = links never expire.
SHARE_LINK_TTL_DAYS=30
# Master key for the encrypted data files. Set it and the store no longer
# depends on the bot token (rotating the token can't brick the data, and a
# leaked token can't decrypt the disk). Straight text (not a Fernet key):
#   openssl rand -hex 32
# BACK IT UP. Losing it means losing the stored data; existing files are
# re-encrypted under it the first time they're read.
# Format: 64 hex characters, or a passphrase of at least 32. Generate:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Rotate (bot STOPPED): ./scripts/rekey_dek.py
DATA_ENCRYPTION_KEY=
# Owner bypass — comma-separated chat IDs with unlimited packages/refreshes
OWNER_CHAT_IDS=
# Operational alerts to OWNER_CHAT_IDS: a rejected 17TRACK key, a tracking-poller
# or Solana-monitor cycle error, a state file that could not be decrypted (kept as
# .locked, that store starts empty), or a second instance hitting the single-
# instance lock. At most one per problem per 30 minutes, and never sent to anyone
# but the IDs above. 0 turns them off. (The backup script has its own switch:
# BACKUP_ALERTS.)
ADMIN_ALERTS=1
# Secret path segment for the 17TRACK webhook: the route becomes
# /webhook/17track/<WEBHOOK_TOKEN>. Generate one (a password manager works) and
# set the SAME webhook URL in 17TRACK's console. Unset = the public path answers
# (works, but anyone who knows a tracked number can force early re-checks).
WEBHOOK_TOKEN=
# USPS Tracking API v3 (new developer portal, OAuth2) — preferred USPS source.
USPS_CONSUMER_KEY=
USPS_CONSUMER_SECRET=
# EXPERIMENTAL: read USPS statuses via a real browser (needs: pip install playwright).
# Slow + fragile — leave blank unless you're curious.
# Reuses a slim copy of your real Chrome profile (works without a Web Tools key).
# Privacy: only cookie files are copied (~10 MB), deleted at every start/stop.
#   USPS_PROFILE_MODE=slim   (recommended)
#   USPS_PROFILE_MODE=full   (revert: old ~1 GB wholesale profile copy)
# USPS_BROWSER_TRACK=1
# USPS_BROWSER_ONDEMAND=1   (only run the browser on /track /update /refresh)
# USPS_BATCH_MAX=35         (USPS numbers checked per browser session)
# Headless USPS sweep: at most this many numbers per browser session, and never
# two sessions closer together than this many seconds. Both exist to bound the
# Akamai bot-flag risk (one session for many numbers beats one per package).
USPS_SWEEP_MAX=35
USPS_SWEEP_MIN_GAP=300
# ── Telegram Mini App (dashboard) ─────────────────────────────
# Public HTTPS URL of the Mini App (cloudflared/ngrok tunnel pointing at
# MINI_APP_HOST:MINI_APP_PORT). When set, the bot adds a "📦 Packages"
# button on the Telegram menu. Leave blank to run the backend local-only.
MINI_APP_URL=
MINI_APP_HOST=127.0.0.1
MINI_APP_PORT=8080
# API budget per Telegram user (sliding window). The backend is publicly
# reachable through the tunnel, so this is what stops a client that replays a
# valid initData from looping the invoice/payment endpoints. The payment sheet
# polls every 5 s, so keep this well above 12/minute.
MINIAPP_RATE_MAX=60
MINIAPP_RATE_WINDOW=60
# ── Pro subscription (USDC / USDT on Solana) ──────────────────
# Solana wallet that receives Pro payments. Without it the Mini App's Pro
# sheet reports "Payments not configured" and the monitor stays off.
BOT_USDC_ADDRESS=
# Your OWN Solana wallet addresses (comma-separated), so the monitor never reads
# your money moving as a customer paying. Funding the receiving wallet from a
# wallet listed here (a refund float, a test transfer) can otherwise be credited
# to whoever happens to have an invoice open — matching by amount, or by timing
# when exactly one invoice is open. Addresses only: never their keys.
# Example: OPERATOR_WALLETS=YourWallet1…,YourTreasury2…
OPERATOR_WALLETS=
# Price and duration are the two knobs you change to reprice Pro. Both are read at
# startup, so restart the bot (./run.sh --background) to apply a change — and every
# surface follows in step: the payment sheet, the receipt, the welcome text.
# Base price in USD. Every invoice adds a random micro-tail on top (e.g. 1.000123):
# it keeps the amount unique, and it is still the identifier for invoices created
# before the payment links carried a reference. See README → Solana payments.
PRO_PRICE_USD=1.00
# How long one activation lasts, in DAYS (30 is the usual production choice).
# Applies to new activations only: a buyer already credited keeps the end date they
# paid for, so changing this never shortens a running subscription.
SUBSCRIPTION_DAYS=7
# How long an expired invoice keeps its amount matchable, so a late payment
# still activates Pro (seconds; 86400 = 24 h).
PAYMENT_GRACE_SECONDS=86400
# Seconds between Solana RPC polls while an invoice is pending.
SOL_POLL_SECONDS=10
# Master seed for per-chat deposit addresses (hex, 32 bytes) — the manual-payment
# path: a buyer who pastes the address into an exchange sends no reference and no
# memo, so there the ADDRESS is what identifies the chat. Generate once, and never
# change it: every chat's address, and the funds sitting on it, derive from this.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Blank = the manual path is off; the QR / payment-link flow keeps working.
DEPOSIT_SEED=
# Solana RPC endpoint used to watch the payment wallet. Leave blank for the
# public mainnet endpoint — which rate-limits hard (429s were measured dropping
# 5 of 15 transaction lookups in one scan), so a paid-payment bot wants a real
# provider. Helius free tier (1M credits/month) is ample for a 10 s poll:
#   1. https://dashboard.helius.dev → sign up → API Keys → copy the key
#   2. SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<YOUR_KEY>
# The key is a secret: never paste it into a chat, repo or log.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<YOUR_KEY>

# ── Pacing, routing & 17TRACK quota ───────────────────────────
# LEGACY: kept so older .env files keep loading. The real per-package cadence
# lives in refresh.CADENCE (delivery day / in transit / pre-scan), which also
# differs by tier — this value is no longer what drives checks.
REFRESH_INTERVAL=300
# A number 17TRACK refuses (usually "carrier cannot be detected" until the
# first acceptance scan) is retried on this interval (seconds).
REGISTER_RETRY_INTERVAL=1800
# Floor between two 17TRACK-webhook-forced refreshes of the same package
# (seconds). The webhook URL carries no secret, so without a floor anyone who
# knows a tracked number could keep every lookup permanently due — bypassing the
# cadence and spending the paid fallbacks. 0 disables the floor.
WEBHOOK_MIN_RESCHEDULE_SECONDS=300
# Source routing: "matrix" (default) reserves 17TRACK for the numbers NO other
# source can check (CN/HK and other international posts), checking carriers
# with an official API through that API instead. "legacy" restores
# "17TRACK first for everything".
SOURCE_ROUTING=matrix
# Quota pressure thresholds (percent of the shared 17TRACK quota): at SOFT the
# non-critical checks are stretched, at HARD they are paused until it resets.
# International/CN/HK numbers are never starved.
TRACK17_SOFT_PCT=70
TRACK17_HARD_PCT=85
# Pro chats only: read UPS/FedEx/DHL on the carrier's own page in the headless
# browser BEFORE spending 17TRACK (its aggregate feed lagged a delivered UPS
# parcel by ~5 h, measured 2026-09-23), and let 17TRACK back a USPS number whose
# official API came up empty. Needs USPS_BROWSER_TRACK=1 to have any effect.
# 0 restores the 17TRACK-first order exactly.
PRO_BROWSER_FIRST=1

# -- Phantom deep-link route (/pay/<id>/phantom): the payment rescue path --
# 1 (default): the pay page offers "pay through the Phantom app" when signing inside a
#             wallet's browser cannot work. Phantom's own deep-link API is used, so
#             "phantom://" is answered by Phantom alone and the transaction we built is
#             what the wallet shows — no "solana:" scheme, no other wallet can take it.
#             Needs: MINI_APP_URL as an https URL (Phantom redirects back there), pynacl
#             installed, and two Phantom round trips (connect, then sign) from the payer.
# 0:          the route 404s. Paying itself is unchanged.
PHANTOM_DEEPLINK=1

# ── USPS extras (see the USPS sections above) ────────────────
# USPS API base URL — override for the USPS TEM sandbox (default apis.usps.com).
USPS_API_BASE_URL=
# Show the browser window during experimental browser-based checks (0 = hidden).
USPS_BROWSER_HEADFUL=0
# How many browser sessions ONE carrier may run at the same time (default 1).
# The four carriers already run in parallel with each other — each holds its
# own profile copy — so a sweep checks USPS, UPS, FedEx and DHL concurrently.
# This knob only multiplies the request rate a SINGLE carrier's bot defense
# sees (the thing that historically got the tier flagged): raise only with a
# reason, and watch the throttle log.
USPS_BROWSER_SLOTS_PER_CARRIER=1
# Browser carriers to skip entirely (comma-separated slugs: usps,ups,dhl,fedex).
# A disabled carrier is never swept and never taken on demand — its packages
# stay on the 17TRACK/API path. Motivated 2026-10-04: dhl.com's tracking
# widget config 404s in every locale, so the DHL browser tier could only ever
# answer no_data. Remove dhl here (or delete the line) when their site works.
#USPS_BROWSER_DISABLED_SLUGS=dhl
# UPS only: spy UPS's own tracking API call (webapis.ups.com/…/Track/GetStatus)
# from the browser session instead of parsing the rendered page. OFF by default:
# the rendered page already answers, and the fire is not guaranteed. Measured on
# the engine's own path (2026-09-24): fired in 6 of 6 windows at 9-12s, so the
# window is 30s. The page parse stays the fallback, so enabling this can only add
# information, never lose an answer.
UPS_BROWSER_JSON=0
# Chrome profile the browser checks copy cookies from. Blank = the default
# profile path for your OS.
# Chrome BINARY the browser tier launches. Blank = /Applications/Google Chrome.app.
USPS_CHROME_PATH=
# Opt-in debugging for the browser tier: when set to a directory path, an EMPTY
# browser result saves that page's text there (one 0600 file per miss) so a
# carrier layout change becomes a test fixture. Contents are redacted:
# tracking-number-shaped digit runs and emails are masked — but NAMES AND
# ADDRESSES ARE NOT. Review a capture before sharing it. Blank = off.
USPS_DEBUG_DIR=
# User-Agent the browser tier presents to carriers. Blank = a current stable
# Chrome on macOS. Override if a carrier starts version-blocking this value.
USPS_BROWSER_UA=
USPS_CHROME_PROFILE=

# ── Ship24 (optional PAID last-resort lookup) ─────────────────
# Ship24 is an aggregator (1,600+ couriers) used ONLY when 17TRACK, the official
# USPS APIs and the USPS browser tier have all come up empty for a number — the
# difference between "Unavailable" and a real status. Billing is per call, so
# leave both values unset unless you accept that cost; each lookup is roughly
# $0.05 at Ship24's overage rate.
# Key: dashboard.ship24.com → Integrations → API Keys (an apik_... value). The
# account must carry the "per-call" subscription — a trackers-only account
# answers 422 no_active_subscription, in which case the bot pauses this source
# for an hour and carries on without it.
SHIP24_API_KEY=
# Hard cap on billed lookups per day (0 turns the fallback off without removing
# the key). The count is in-memory, so a restart starts the day over.
SHIP24_DAILY_MAX=50
